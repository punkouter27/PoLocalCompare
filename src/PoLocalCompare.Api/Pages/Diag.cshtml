@page
@model PoLocalCompare.Api.Pages.DiagModel
@* /diag — anonymous in every environment. The same shell as the app (po-tokens.css: header,
   gear, stamp, status cards) so it reads as one of its pages; no inline script or style, so it
   loads under any CSP the app sends. Status cards come from diag-health.js over GET /api/diag,
   which carries no endpoint, key, path or exception message. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Diagnostics · PoLocalCompare</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="stylesheet" href="/css/po-tokens.css?v=2" />
    <link rel="stylesheet" href="/css/diag.css?v=2" />
    <script src="/js/po-devwindow.js?v=1"></script>
</head>
<body>
    <header class="po-header">
        <a class="po-header__title" href="/">
            <span class="diag__glyph" aria-hidden="true">PL</span>
            <span>PoLocalCompare</span>
        </a>
        <div class="po-header__actions">
            @if (Model.Email is not null)
            {
                <span class="po-header__email" title="@Model.Email">@Model.Email</span>
            }
            else
            {
                <a class="diag__btn diag__btn--primary" href="/auth/login?returnUrl=%2Fdiag">Sign in</a>
            }
        </div>
    </header>

    <main class="po-diag">
        <div class="diag__intro">
            <h1 class="diag__title">Diagnostics</h1>
            <p class="diag__lead">
                Is everything working? This page checks the app itself, where it keeps its data and
                the outside services it relies on. It uses the same checks as the health probe, so the
                two always agree.
            </p>
        </div>

        <p id="diag-banner" class="diag__banner diag__banner--idle" role="status">Checking…</p>

        <div class="diag__toolbar">
            <button type="button" class="diag__btn diag__btn--primary" id="diag-refresh">Refresh</button>
            <span class="diag__meta" id="diag-checked"></span>
            <span class="diag__meta">Build <strong>v@(PoLocalCompare.Api.Pages.DiagModel.Stamp)</strong></span>
            <span class="diag__meta">Environment <strong id="diag-environment">…</strong></span>
        </div>

        <section class="po-diag__group" aria-labelledby="diag-api">
            <h2 class="diag__group-title" id="diag-api">API</h2>
            <div id="diag-api-cards" class="diag__cards"><p class="diag__empty">Checking…</p></div>
        </section>

        <section class="po-diag__group" aria-labelledby="diag-data">
            <h2 class="diag__group-title" id="diag-data">Data</h2>
            <div id="diag-store-cards" class="diag__cards"><p class="diag__empty">Checking…</p></div>
        </section>

        <section class="po-diag__group" aria-labelledby="diag-services">
            <h2 class="diag__group-title" id="diag-services">Services</h2>
            <div id="diag-service-cards" class="diag__cards"><p class="diag__empty">Checking…</p></div>
        </section>

        <section class="po-diag__group" aria-labelledby="diag-config">
            <h2 class="diag__group-title" id="diag-config">Settings in effect</h2>
            <dl class="diag__config">
                @foreach (var item in Model.ConfigItems)
                {
                    <div class="diag__config-row"><dt>@item.Key</dt><dd>@item.Value</dd></div>
                }
            </dl>
        </section>

        <section class="po-diag__group diag__models" aria-labelledby="diag-models">
            <h2 class="diag__group-title" id="diag-models">Model health</h2>
            <p class="mh-note">
                Runs one short prompt through every registered model and reports what came back.
                Remote models are checked by the server, Ollama models on the local daemon, and
                browser models on this tab's GPU, so leave the page open while they run.
                Signing in is needed to read the model list.
            </p>

            <div class="mh-env" id="mh-env">
                <span class="mh-env__item">Checking this device…</span>
            </div>

            <div class="mh-actions">
                <button type="button" class="diag__btn diag__btn--primary" id="mh-run">Test all models</button>
                <button type="button" class="diag__btn" id="mh-cancel" disabled>Cancel</button>
                <button type="button" class="diag__btn" id="mh-refresh">Reload list</button>
                <input class="mh-prompt" id="mh-prompt" aria-label="Test prompt"
                       value="In one sentence, explain what an API is." />
            </div>

            <div class="diag__table-wrap" tabindex="0" role="region" aria-labelledby="diag-models">
                <table class="diag__table">
                    <thead>
                        <tr>
                            <th scope="col">Model</th>
                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            <th scope="col">Load</th>
                            <th scope="col">Tok/s</th>
                            <th scope="col">Note</th>
                        </tr>
                    </thead>
                    <tbody id="mh-rows">
                        <tr><td colspan="6">Loading the model list…</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="mh-note" id="mh-summary" role="status"></p>
        </section>
    </main>

    <span class="po-version" aria-label="Build version">v@(PoLocalCompare.Api.Pages.DiagModel.Stamp)</span>

    @* The probing half of model health: WebGPU/WebNN capability, local-asset resolution and the
       WebLLM worker runner. webllm-interop is loaded first because diag-interop's checkModelFile
       calls its resolveBrowserModelAvailability. *@
    <script src="/js/webllm-interop.js?v=6"></script>
    <script src="/js/diag-interop.js?v=8"></script>
    <script src="/js/diag-models.js?v=3"></script>
    <script src="/js/diag-health.js?v=2"></script>
</body>
</html>
