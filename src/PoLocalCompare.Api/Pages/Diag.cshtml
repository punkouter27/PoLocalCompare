@page
@model PoLocalCompare.Api.Pages.DiagModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Diagnostics — PoLocalCompare</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0;
            background: radial-gradient(circle at top right, #102016 0%, #060809 45%, #040506 100%);
            color: #ecf4f0;
            font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
            font-size: 0.9rem;
            min-height: 100vh;
        }
        .diag-header {
            background: rgba(6, 8, 9, 0.92);
            border-bottom: 1px solid #1e2723;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.5rem;
            position: sticky;
            top: 0;
            backdrop-filter: blur(8px);
            z-index: 10;
        }
        .diag-header__title { font-weight: 700; font-size: 1rem; color: #fff; margin: 0; }
        /* SC 2.5.8 Target Size — these were 15px tall, well under the 24px minimum the rest
           of the app holds to. Padding rather than font-size keeps the header compact. */
        .diag-header__back {
            color: #22c55e;
            text-decoration: none;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
            min-height: 24px;
            padding: 0 0.25rem;
        }
        .diag-header__back:hover { text-decoration: underline; }
        .diag-header__back:focus-visible { outline: 2px solid #40e48e; outline-offset: 2px; }
        /* An inline link in prose is exempt from the target minimum, so the one in the lead
           paragraph opts back out rather than inflating the line height around it. */
        .diag-lead .diag-header__back { min-height: 0; padding: 0; display: inline; }
        .diag-body { padding: 1.5rem; max-width: 980px; }
        h1 { color: #40e48e; font-size: 1.5rem; margin: 0 0 0.4rem; }
        .diag-lead {
            margin: 0 0 1.2rem;
            color: #9cb4aa;
            max-width: 70ch;
            line-height: 1.45;
        }
        .diag-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 0.9rem;
            margin-bottom: 1.1rem;
        }
        .diag-summary__card {
            background: linear-gradient(180deg, #0f1513 0%, #0a0f0d 100%);
            border: 1px solid #1f2a25;
            border-radius: 8px;
            padding: 0.8rem 0.9rem;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
        }
        .diag-summary__label {
            color: #8a9b94;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            font-size: 0.7rem;
            margin-bottom: 0.3rem;
        }
        .diag-summary__value {
            font-weight: 700;
            color: #f8fffb;
            font-size: 1.15rem;
        }
        .diag-summary__value--ok { color: #4ade80; }
        .diag-summary__value--warn { color: #f59e0b; }
        .diag-summary__value--bad { color: #f87171; }
        section {
            margin-bottom: 1rem;
            background: linear-gradient(180deg, #0d1210 0%, #070b09 100%);
            border: 1px solid #1a2420;
            border-radius: 8px;
            padding: 1rem 1.25rem;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.26);
        }
        h2 { color: #9ab1a7; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.75rem; border-bottom: 1px solid #1a2320; padding-bottom: 0.4rem; }
        p { margin: 0.35rem 0; color: #e5e7eb; }
        strong { color: #22c55e; }
        code { color: #7dd3fc; background: #111814; padding: 0.1rem 0.3rem; border-radius: 3px; }
        /* Tables scroll inside their own box. Without this the Configuration Keys table pushed
           the document to 425px on a 390px viewport and the whole page scrolled sideways.
           tabindex=0 in the markup makes the scroll area keyboard-operable (SC 2.1.1). */
        .diag-table-wrap { overflow-x: auto; }
        .diag-table-wrap:focus-visible { outline: 2px solid #40e48e; outline-offset: 2px; }
        table { width: 100%; border-collapse: collapse; min-width: 22rem; }
        /* #7b8d86 on #0a0f0d is 4.0:1 — under the 4.5:1 minimum for this size (SC 1.4.3). */
        th { text-align: left; color: #9fb2ab; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.4rem 0.5rem; border-bottom: 1px solid #1b2622; }
        td { padding: 0.35rem 0.5rem; border-bottom: 1px solid #0d1411; color: #d1d5db; }
        td:first-child { color: #9ca3af; }
        tr:last-child td { border-bottom: none; }
        .diag-status-chip {
            display: inline-block;
            padding: 0.15rem 0.55rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 700;
            border: 1px solid;
            vertical-align: middle;
            margin-left: 0.25rem;
        }
        .diag-status-chip--ok {
            color: #4ade80;
            background: rgba(74, 222, 128, 0.14);
            border-color: rgba(74, 222, 128, 0.45);
        }
        .diag-status-chip--bad {
            color: #fca5a5;
            background: rgba(248, 113, 113, 0.14);
            border-color: rgba(248, 113, 113, 0.48);
        }

        /* ── Model health ──────────────────────────────────────────────────
           Moved here from the Home page on 2026-08-23. It is a diagnostic, not part of the
           duel flow, and it belongs beside the dependency checks it complements. Rebuilt in
           vanilla JS rather than ported: this is a server-rendered Razor Page on purpose (it
           has to work when the WASM client is the broken thing), so it cannot host a Blazor
           component. The probing half already lived in framework-free /js/diag-interop.js. */
        .mh-env {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem 0.8rem;
            padding: 0.6rem 0.75rem;
            margin-bottom: 0.8rem;
            border: 1px solid #1f2a25;
            border-radius: 6px;
            background: #0a0f0d;
        }
        .mh-env__item { color: #c7d3ce; }
        .mh-env__item--ok { color: #4ade80; }
        .mh-env__item--bad { color: #fca5a5; }
        .mh-env__item--muted { color: #7f8f89; }
        .mh-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.8rem;
        }
        .mh-btn {
            font: inherit;
            min-height: 32px;
            padding: 0.3rem 0.85rem;
            border-radius: 6px;
            border: 1px solid #2a3a33;
            background: #101815;
            color: #d6e4de;
            cursor: pointer;
        }
        .mh-btn:hover:not(:disabled) { border-color: #40e48e; }
        .mh-btn:focus-visible { outline: 2px solid #40e48e; outline-offset: 2px; }
        .mh-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .mh-btn--primary { background: #14361f; border-color: #2f7a4a; color: #b8f5cf; }
        .mh-prompt {
            font: inherit;
            flex: 1 1 18rem;
            min-width: 0;
            min-height: 32px;
            padding: 0.3rem 0.5rem;
            border-radius: 6px;
            border: 1px solid #1f2a25;
            background: #070b09;
            color: #d6e4de;
        }
        .mh-prompt:focus-visible { outline: 2px solid #40e48e; outline-offset: 1px; }
        .mh-note { color: #8a9b94; font-size: 0.8rem; margin: 0 0 0.8rem; }
        .mh-st--ok      { color: #4ade80; }
        .mh-st--bad     { color: #fca5a5; }
        .mh-st--run     { color: #fbbf24; }
        .mh-st--idle    { color: #7f8f89; }
        .mh-st--skip    { color: #7f8f89; }
        .mh-num { font-variant-numeric: tabular-nums; }
        .mh-detail { color: #8a9b94; }
    </style>
</head>
<body>
    @* Landmarks: axe flagged nine unlandmarked regions and no <main> at all. Header/main are
       the whole fix — every section already sits inside the body div. *@
    <header class="diag-header">
        <span class="diag-header__title">PoLocalCompare</span>
        <a class="diag-header__back" href="/">← Back to App</a>
        <a class="diag-header__back" href="/health">Health JSON</a>
    </header>
    <main class="diag-body">
        <h1>Diagnostics</h1>
        <p class="diag-lead">
            Runtime observability snapshot for local troubleshooting. Use this page first when startup or middleware behavior looks inconsistent.
            Connection states below come from the same health checks <a class="diag-header__back" href="/health">/health</a> reports, so the two always agree.
        </p>

        <div class="diag-summary">
            <div class="diag-summary__card">
                <div class="diag-summary__label">Overall Status</div>
                <div class="diag-summary__value @(Model.IsHealthy ? "diag-summary__value--ok" : "diag-summary__value--bad")">@Model.OverallStatus</div>
            </div>
            @foreach (var dep in Model.Dependencies)
            {
                var ok = string.Equals(dep.Status, "Healthy", StringComparison.OrdinalIgnoreCase);
                var notConfigured = string.Equals(dep.Status, "NotConfigured", StringComparison.OrdinalIgnoreCase);
                var valueClass = notConfigured
                    ? "diag-summary__value--warn"
                    : ok ? "diag-summary__value--ok" : "diag-summary__value--bad";
                <div class="diag-summary__card">
                    <div class="diag-summary__label">@dep.Name</div>
                    <div class="diag-summary__value @valueClass">@dep.Status</div>
                </div>
            }
        </div>

        <section>
            <h2 id="diag-connections">Connections</h2>
            <div class="diag-table-wrap" tabindex="0" role="region" aria-labelledby="diag-connections">
            <table>
                <thead><tr><th>Dependency</th><th>Status</th><th>Latency</th><th>Detail</th></tr></thead>
                <tbody>
                    @foreach (var dep in Model.Dependencies)
                    {
                        var ok = string.Equals(dep.Status, "Healthy", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td>@dep.Name</td>
                            <td>
                                <span class="diag-status-chip @(ok ? "diag-status-chip--ok" : "diag-status-chip--bad")">@dep.Status</span>
                            </td>
                            <td>@(dep.LatencyMs is null ? "—" : $"{dep.LatencyMs} ms")</td>
                            <td>@(dep.Error ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </section>

        <section>
            <h2>Endpoints (masked)</h2>
            <p>Azure AI Foundry: <code>@Model.MaskValue(Model.FoundryEndpoint)</code></p>
            <p>Key Vault: <code>@Model.MaskValue(Model.KeyVaultUri)</code></p>
        </section>

        <section>
            <h2 id="diag-config">Configuration Keys</h2>
            <div class="diag-table-wrap" tabindex="0" role="region" aria-labelledby="diag-config">
            <table>
                <thead><tr><th>Key</th><th>Value</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.ConfigItems)
                    {
                        <tr><td>@item.Key</td><td>@item.Value</td></tr>
                    }
                </tbody>
            </table>
            </div>
        </section>

        <section>
            <h2 id="diag-models">Model health</h2>
            <p class="mh-note">
                Runs one short prompt through every registered model and reports what came back.
                Remote models are probed server-side; Ollama models run on the local daemon;
                browser models run on this tab's GPU, so leave the page open while they do.
            </p>

            <div class="mh-env" id="mh-env">
                <span class="mh-env__item">Checking environment…</span>
            </div>

            <div class="mh-actions">
                <button type="button" class="mh-btn mh-btn--primary" id="mh-run">Test all models</button>
                <button type="button" class="mh-btn" id="mh-cancel" disabled>Cancel</button>
                <button type="button" class="mh-btn" id="mh-refresh">Reload catalog</button>
                <input class="mh-prompt" id="mh-prompt" aria-label="Verification prompt"
                       value="In one sentence, explain what an API is." />
            </div>

            <div class="diag-table-wrap" tabindex="0" role="region" aria-labelledby="diag-models">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Model</th>
                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            <th scope="col">Load</th>
                            <th scope="col">Tok/s</th>
                            <th scope="col">Note</th>
                        </tr>
                    </thead>
                    <tbody id="mh-rows">
                        <tr><td colspan="6">Loading catalog…</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="mh-note" id="mh-summary" role="status"></p>
        </section>

        @* The probing half of the old Blazor panel: WebGPU/WebNN capability, local-asset
           resolution and the WebLLM worker runner. Framework-free already, which is why the
           panel could move to a Razor Page at all. webllm-interop is loaded first because
           diag-interop's checkModelFile calls its resolveBrowserModelAvailability. *@
        <script src="/js/webllm-interop.js?v=6"></script>
        <script src="/js/diag-interop.js?v=8"></script>
        <script src="/js/diag-models.js?v=2"></script>
    </main>
</body>
</html>
