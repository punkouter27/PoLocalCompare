<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <!-- The vision judge's Playwright driver is a ~77 MB Node binary. Vision judging is off in
         Production (AiJudge:VisionEnabled), so a Release publish ships no driver at all; the
         renderer degrades to source-only judging if it is ever asked. -->
    <PlaywrightPlatform Condition="'$(Configuration)' == 'Release'">none</PlaywrightPlatform>
    </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildStamp" Value="$([System.DateTime]::UtcNow.ToString('yyMMdd'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoLocalCompare.Shared\PoLocalCompare.Shared.csproj" />
    <ProjectReference Include="..\PoLocalCompare.Client\PoLocalCompare.Client.csproj" />
  </ItemGroup>

  <!-- SseChatStreamReader is internal on purpose (a helper the proxies own, not a service),
       but it is also the one piece of inference code with no HTTP of its own — it takes an
       already-connected response — so it is unit-testable and worth testing. Prefer this over
       widening the type to public just to reach it from a test. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PoLocalCompare.Unit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="NUlid" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    <!-- Headless Chromium for the vision judge (Common/Rendering). Feature-flagged off by
         default: the Free-tier App Service has no browser and no room for one, so this is a
         local/self-hosted capability, not a deploy dependency. -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <!-- Not optional despite nothing calling UseWebAssemblyDebugging: this package supplies
         UseBlazorFrameworkFiles(), which is how this host serves the WASM client's _framework
         payload. Removing it fails the build at Program.cs. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>
