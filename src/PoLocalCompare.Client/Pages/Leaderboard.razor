@page "/leaderboard"
@using PoLocalCompare.Client.Components
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Leaderboard — PoLocalCompare</PageTitle>

@inject DuelApiClient ApiClient
@inject PreferencesService Prefs
@inject AudioService AudioService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="leaderboard po-page po-page--wide">
    <PageHeader Title="Leaderboard" TitleHook="leaderboard__title" />

    @if (_loading)
    {
        <p class="po-status">Loading leaderboard...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <p class="po-error">@_error</p>
    }
    else
    {
        // Exactly one state at a time. This used to render the empty banner AND the ranking
        // table AND the summary bar together — "No competitive history yet" above a table with
        // zero rows above "26 models ranked / Top ELO: X", three sentences that contradicted
        // each other. No duelled model ⇒ nothing to rank, so the banner is the whole page.
        if (_entries.Count == 0 || _entries.All(e => e.DuelCount == 0))
        {
            <EmptyState Icon="🏁"
                        Title="No competitive history yet"
                        Hint="Run your first duel to generate ELO trends, win rates and quality comparisons."
                        Actions="@(new[] {
                            new EmptyStateAction("⚔ Start a duel", "/", EmptyStateActionVariant.Ghost)
                        })" />
        }
        else
        {
        var judged = _entries.Sum(e => e.DuelCount) / 2;
        @* The one figure the old three-item summary bar carried that the table does not: the
           model count is the row count and the top ELO is row one. *@
        <p class="po-hint">@judged duel@(judged == 1 ? "" : "s") judged</p>

        @* Chart then table in the DOM (and stacked, below 1400px); from 1400px the table takes
           the left column and the chart a sticky right one, so the ranking starts at the top
           of the page instead of under a 400px figure.

           With a model picked (?model=, from 1024px) that right column is the model's profile
           instead — the board and the "why" on one page. The chart steps aside while it is
           open; closing the panel brings it back. *@
        <div class="leaderboard__layout @(PanelOpen ? "leaderboard__layout--panel" : null)">
        @if (!PanelOpen && _showChart)
        {
            <div class="leaderboard__chart">
                <ValueChart Entries="_displayedEntries" />
            </div>
        }
        <div class="leaderboard__main">

        @* Plain .po-table-wrap. This used to also carry a local `leaderboard__grid--scrollable`
           class whose only rule was another `overflow-x: auto` — a second horizontal-scroll
           mechanism competing with the one .po-table-wrap already provides, and with the one
           .po-table--cards switches off at 640px. See the table-strategy note in app.css. *@
        <div class="po-table-wrap">
            <table class="po-table po-table--selectable po-table--cards leaderboard__grid">
                <caption class="visually-hidden">Model rankings - select a model name to open its profile</caption>
                <thead>
                    <tr>
                        <th scope="col">Rank</th>
                        <th scope="col">Model Name</th>
                        <th scope="col">ELO</th>
                        <th scope="col" title="Wins–losses. Losses are total duels minus wins minus draws; a model that failed to produce output lost that duel.">Record</th>
                        <th scope="col" class="leaderboard__derived" title="Mean API cost per duel across every priced result this model has. Local and Ollama models run on your own hardware and show &mdash;.">💰 Avg $/duel</th>
                        <th scope="col" class="leaderboard__derived" title="Median time to first token across this model's duels. Lower is better; local models with no measured run show &mdash;.">⚡ First token</th>
                        <th scope="col" class="leaderboard__derived" title="ELO earned per dollar of API spend (CurrentElo / AvgApiCostPerDuel, divisor floored at $0.0001). Higher = more bang per buck. Local/Ollama and unpriced remotes show &mdash;.">💎 Value</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _displayedEntries.Count; i++)
                    {
                        var entry = _displayedEntries[i];
                        var dr = i + 1;
                        @* No handler on the row itself: a <tr> is not an operable control, and
                           the link in the name cell is now the whole affordance rather than a
                           keyboard fallback for a pointer-only row click. *@
                        var move = _moved.GetValueOrDefault(entry.ModelId.ToString());
                        @* data-rank-row is the FLIP hook (wow.js flipRows): the row is already in its
                           new place, and plays in from where its old rank sits on screen. *@
                        var picked = PanelOpen && entry.ModelId.Value == PanelModel;
                        <tr @key="entry.ModelId" class="po-reveal @(picked ? "leaderboard__row--picked" : null)" data-rank-row="@entry.ModelId">
                            <td class="po-cell--bare leaderboard__rank-cell">
                                @* The medal is decoration and the rank is the content: the glyph is
                                   hidden and the ordinal stated, since a title is not reliably read. *@
                                @{ var medal = dr switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => null }; }
                                <span class="leaderboard__rank @(dr switch { 1 => "leaderboard__rank--gold po-glow", 2 => "leaderboard__rank--silver", 3 => "leaderboard__rank--bronze", _ => "" })">
                                    @if (medal is null)
                                    {
                                        @dr
                                    }
                                    else
                                    {
                                        <span aria-hidden="true">@medal</span><span class="visually-hidden">Rank @dr</span>
                                    }
                                </span>
                                @if (move?.From is int from && move.To is int to && from != to)
                                {
                                    var up = to < from;
                                    var places = Math.Abs(from - to);
                                    <span class="leaderboard__shift @(up ? "leaderboard__shift--up" : "leaderboard__shift--down")"
                                          title="@($"{(up ? "Up" : "Down")} {places} since you last looked (was #{from})")">
                                        <span aria-hidden="true">@(up ? "▲" : "▼")@places</span>
                                        <span class="visually-hidden">@(up ? "Up" : "Down") @places since your last visit</span>
                                    </span>
                                }
                            </td>
                            <td data-label="Model" class="leaderboard__name-cell">
                                @* Opens the model's own page. This used to expand a kill-list
                                   drawer under the table; the kill list answers a question about
                                   one model, so it moved to that model's page along with the
                                   rating history and output gallery it belongs beside. *@
                                @* data-vt: opens the profile through a view transition — this link
                                   morphs into the profile's card (wow.js). Narrow screens only:
                                   from 1024px the click opens the side panel instead, and the
                                   href stays the profile page for a new tab or a copied link. *@
                                <a class="po-btn po-btn--ghost po-btn--sm leaderboard__row-btn"
                                   href="@($"/model/{entry.ModelId}")"
                                   data-vt="@(_wide ? null : ".profile__card")"
                                   aria-current="@(picked ? "true" : null)"
                                   title="@($"Open {entry.DisplayName}")"
                                   @onclick="@(() => OpenModel(entry))"
                                   @onclick:preventDefault="_wide">
                                    @entry.DisplayName
                                    <ModelTypeBadge Type="entry.ModelType" AdditionalClass="leaderboard__type-badge-spacing" />
                                </a>
                            </td>
                            @* The ± is the half-width of a 95% interval from a Bradley–Terry fit
                               over every judged duel (server: BradleyTerry). It is the evidence
                               behind the number: two models 30 points apart with ±120 each are
                               not meaningfully ranked, and nothing on the row said so before.
                               Never optional: how settled a rating is, is what this board is for. *@
                            <td data-label="ELO" class="leaderboard__elo">
                                <span class="leaderboard__record">@((int)Math.Round(entry.CurrentElo))</span>
                                @{
                                    var narrowed = move?.NarrowedFrom is double wasWide
                                        ? $" Narrowed from ±{wasWide:F0} since you last looked." : null;
                                }
                                <span class="leaderboard__ci @(narrowed is null ? null : "leaderboard__ci--narrowed")"
                                      title="@(IntervalTitle(entry) + narrowed)">±@((int)Math.Round(entry.RatingInterval))</span>
                                @if (entry.IsProvisional)
                                {
                                    <span class="leaderboard__provisional" title="Fewer than 10 judged duels — this rating will still move a lot.">provisional</span>
                                }
                            </td>
                            @* W–L in one cell. The draw count is deliberately left out — it is
                               recoverable from DuelCount and is near-always zero. *@
                            <td data-label="Record" class="leaderboard__record leaderboard__record-cell">@entry.WinCount–@Losses(entry)</td>
                            <td data-label="Avg $/duel" class="po-cell--secondary leaderboard__derived">
                                @* Four decimals: a duel on a nano model costs a few ten-thousandths
                                   of a dollar, and rounding to cents renders the whole column as
                                   $0.00. Suppressed rather than zeroed for unpriced models — free
                                   and unmeasured are different facts. *@
                                @if (entry.AvgApiCostPerDuel is { } cost)
                                {
                                    <span class="leaderboard__record">$@cost.ToString("F4")</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data" title="No priced duels yet — local and Ollama models have no per-token rate.">&#8212;</span>
                                }
                            </td>
                            <td data-label="First token" class="po-cell--secondary leaderboard__derived">
                                @if (entry.AvgFirstTokenMs is { } ttft)
                                {
                                    <span class="leaderboard__ttft">@FormatFirstToken(ttft)</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data" title="No completed run has recorded a first-token time yet.">&#8212;</span>
                                }
                            </td>
                            <td data-label="Value" class="po-cell--secondary leaderboard__derived">
                                @* Value = ELO earned per dollar of API spend, with the divisor
                                   floored at $0.0001 server-side. Reads as a big number, hence the
                                   tabular-nums treatment; suppress for rows that have no cost. *@
                                @if (entry.Value.HasValue)
                                {
                                    <span class="leaderboard__value" title="@($"ELO {entry.CurrentElo} / {entry.AvgApiCostPerDuel:F4} USD per duel")">@entry.Value.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="leaderboard__no-data" title="No priced duels yet — Value needs at least one priced result.">&#8212;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* The models with no judged duel. They are not ranked — an unplayed model is a 1200
           with no record — but the board used to leave 24 of 26 models unmentioned, so the
           list read as the whole catalog. Collapsed, and each name still opens its profile. *@
        @if (UnplayedEntries.Count > 0)
        {
            <details class="leaderboard__unplayed">
                <summary>Not yet played (@UnplayedEntries.Count)</summary>
                <ul class="leaderboard__unplayed-list">
                    @foreach (var entry in UnplayedEntries)
                    {
                        <li @key="entry.ModelId">
                            <a href="@($"/model/{entry.ModelId}")"
                               @onclick="@(() => OpenModel(entry))"
                               @onclick:preventDefault="_wide">@entry.DisplayName</a>
                        </li>
                    }
                </ul>
            </details>
        }
        </div>

        @if (PanelOpen)
        {
            <aside class="leaderboard__panel po-glass" aria-label="Model profile">
                <div class="leaderboard__panel-bar">
                    <a class="po-btn po-btn--sm po-btn--ghost" href="@($"/model/{Uri.EscapeDataString(PanelModel!)}")">
                        Open full page <span aria-hidden="true">↗</span>
                    </a>
                    @if (PanelPicked)
                    {
                        <a class="po-btn po-btn--sm po-btn--ghost" href="/leaderboard" aria-label="Close the profile panel">
                            <span aria-hidden="true">✕</span> Close
                        </a>
                    }
                </div>
                <ModelProfile ModelIdText="@PanelModel" Embedded="true" />
            </aside>
        }
        </div>
        }
    }
</div>

@code {
    /// <summary>The model whose profile is open in the side panel (?model=).</summary>
    [SupplyParameterFromQuery(Name = "model")] public string? SelectedModel { get; set; }

    /// <summary>
    /// 1024px and up: a model name opens the side panel. Asked once, at first render — below
    /// that the panel would be stacked out of sight, so the name opens the model's page.
    /// </summary>
    private bool _wide;

    /// <summary>Set after load: the chart is switched on in Settings and has anything to plot.</summary>
    private bool _showChart;

    /// <summary>
    /// The model in the panel: the one picked, or — from 1024px, when there is no chart
    /// (switched off, or no priced duels yet) — the leader, so the right column is never just empty.
    /// </summary>
    private string? PanelModel =>
        RouteIdShape.IsPlausible(SelectedModel) ? SelectedModel
        : _wide && !_showChart && _displayedEntries.Count > 0 ? _displayedEntries[0].ModelId.Value
        : null;

    private bool PanelOpen => PanelModel is not null;

    /// <summary>Opened by a click, so it can be closed; the default leader panel cannot.</summary>
    private bool PanelPicked => RouteIdShape.IsPlausible(SelectedModel);

    private List<LeaderboardEntryDto> _entries = [];
    private List<LeaderboardEntryDto> _displayedEntries = [];
    private List<LeaderboardEntryDto> UnplayedEntries => _entries.Where(e => e.DuelCount == 0).ToList();

    private void OpenModel(LeaderboardEntryDto entry)
    {
        _ = AudioService.PlayTickAsync();
        if (_wide)
            Nav.NavigateTo($"/leaderboard?model={Uri.EscapeDataString(entry.ModelId.Value)}");
    }
    /// <summary>
    /// Models that have never duelled are hidden. This was a checkbox next to the sort bar and
    /// went with it on 2026-08-23 — it defaulted to on, and an unplayed model is a 1200 with no
    /// record, which is a catalog entry rather than a ranking.
    /// </summary>
    private const bool ActiveOnly = true;
    private bool _loading = true;
    private string? _error;

    /// <summary>
    /// The board is ranked by ELO and nothing else. The five-way sort bar (Value / Speed /
    /// Output Quality / Avg $ per duel) was removed on 2026-08-23: the rating is the thing the
    /// app exists to produce, the alternate orderings restated columns already on the row, and
    /// two of the five silently disabled themselves whenever no duel had recorded the metric.
    /// The API still takes a `sortBy`, so a view can be added back without a server change.
    /// </summary>
    private const string SortBy = "Elo";

    /// <summary>
    /// Losses are not stored — they are whatever is left after wins and draws, which is the
    /// same derivation <see cref="LeaderboardEntryDto.DrawCount"/> documents. Floored at zero
    /// so a partially-written aggregate can never render a negative record.
    /// </summary>
    private static int Losses(LeaderboardEntryDto e) =>
        Math.Max(0, e.DuelCount - e.WinCount - e.DrawCount);

    /// <summary>Tooltip spelling out what the ± is, with the range it implies.</summary>
    private static string IntervalTitle(LeaderboardEntryDto e) =>
        $"95% interval on strength: {e.Strength - e.RatingInterval:F0}–{e.Strength + e.RatingInterval:F0} " +
        $"(Bradley–Terry fit over every judged duel; strength {e.Strength:F0}). Narrows as the model plays more.";

    /// <summary>Sub-second waits read better in ms; past that, seconds.</summary>
    private static string FormatFirstToken(double ms) =>
        ms < 1000 ? $"{ms:F0} ms" : $"{ms / 1000.0:F1} s";

    /// <summary>
    /// What moved since this viewer last opened the board, keyed by model id. Comes from
    /// wow.js, which keeps the previous standing in localStorage — "since you last looked" is
    /// about one person, so it is per-viewer state, not something the server should hold.
    /// </summary>
    private Dictionary<string, RankMove> _moved = [];
    private bool _diffed;
    private bool _flipPending;

    /// <summary>One row's change, as wow.js rankDiff reports it.</summary>
    private sealed class RankMove
    {
        public int? From { get; set; }
        public int? To { get; set; }
        public double? NarrowedFrom { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _wide = await JS.InvokeAsync<bool>("poMatches", "(min-width: 1024px)");
                if (_wide) StateHasChanged();
            }

            if (!_diffed && !_loading && _displayedEntries.Count > 0)
            {
                _diffed = true;
                var rows = _displayedEntries
                    .Select((e, i) => new { id = e.ModelId.ToString(), rank = i + 1, interval = e.RatingInterval })
                    .ToArray();
                _moved = await JS.InvokeAsync<Dictionary<string, RankMove>>("poWow.rankDiff", (object)rows) ?? [];

                if (_moved.Count > 0)
                {
                    _flipPending = true;
                    StateHasChanged();
                }
            }
            else if (_flipPending)
            {
                _flipPending = false;
                _ = AudioService.PlayRankShiftAsync(
                    _moved.Values.Count(m => m.To < m.From),
                    _moved.Values.Count(m => m.To > m.From));
                await JS.InvokeVoidAsync("poWow.flipRows", _moved);
            }
        }
        catch (JSException)
        {
            // Decoration: a board without the reshuffle is still the board.
        }
    }

    // The row's type badge reads LeaderboardEntryDto.ModelType. This used to fetch the whole
    // /api/models catalog in parallel purely to look each row's type up by id.
    protected override Task OnInitializedAsync() => LoadLeaderboardAsync();

    private async Task LoadLeaderboardAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var rows = await ApiClient.GetLeaderboardAsync(SortBy);
            _entries = rows?.ToList() ?? [];
            _displayedEntries = ActiveOnly ? _entries.Where(e => e.DuelCount > 0).ToList() : _entries;
            _showChart = Prefs.IsOn(Preference.LeaderboardChart) && ValueChartLayout.Build(_displayedEntries) is not null;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load leaderboard: {ex.Message}";
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }

    // No row keydown handler and no row tabindex: the model-name cell holds a real anchor, so
    // focus, Enter and the browser's own open-in-new-tab affordances all come for free.
}

