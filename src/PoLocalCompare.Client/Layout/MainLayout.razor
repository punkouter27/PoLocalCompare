@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject IWebAssemblyHostEnvironment HostEnv
@inject IJSRuntime JS

<RadzenComponents />

<div class="page">
    @* SC 2.4.1 Bypass Blocks — first tab stop skips the nav.
       The href is kept for semantics, but focus is moved explicitly: Blazor intercepts
       same-document anchor clicks as router navigation, so the browser never runs its native
       "focus the fragment target" step and the link would scroll without moving focus. *@
    <a class="skip-link" href="#main-content" @onclick="FocusMainAsync">Skip to main content</a>

    <NavMenu />

    <main id="main-content" tabindex="-1">
        <article class="content app-content">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    @if (HostEnv.IsDevelopment() || HostEnv.IsEnvironment("Test"))
                    {
                        <div class="dev-error-panel">
                            <h4>⚠ Unhandled Exception (@HostEnv.Environment)</h4>
                            <p><strong>@ex.GetType().FullName</strong>: @ex.Message</p>
                            <pre>@ex.StackTrace</pre>
                            @if (ex.InnerException is not null)
                            {
                                <p><strong>Inner:</strong> @ex.InnerException.Message</p>
                            }
                            <button type="button" class="po-btn po-btn--sm po-btn--secondary" @onclick="Recover">Retry</button>
                        </div>
                    }
                    else
                    {
                        <div class="prod-error-panel">
                            <p>An unexpected error occurred. Please refresh the page or try again later.</p>
                            <button type="button" class="po-btn po-btn--sm po-btn--secondary" @onclick="Recover">Retry</button>
                        </div>
                    }
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>

    <BottomNav />
    <BuildVersion />
</div>

@code {
    private async Task FocusMainAsync() => await JS.InvokeVoidAsync("focusElement", "main-content");

    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        // Reset the error boundary on each navigation so the error
        // doesn't persist across pages.
        _errorBoundary?.Recover();
    }

    private void Recover() => _errorBoundary?.Recover();
}
