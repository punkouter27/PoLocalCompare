@using PoLocalCompare.Shared.Validation
@* The inline error under a prompt box. ValidationMessage re-renders itself whenever the
   EditContext's validation state changes, so the parent never has to push messages down. *@
<CascadingValue Value="Check.Context" IsFixed="true">
    <FluentValidationValidator TModel="PromptForm" Validator="Validator" />
    <div id="@Id" class="prompt-error" aria-live="polite">
        <ValidationMessage For="() => Check.Form.PromptText" />
    </div>
</CascadingValue>

@code {
    private static readonly PromptFormValidator Validator = new();

    [Parameter, EditorRequired] public PromptCheck Check { get; set; } = default!;

    /// <summary>Referenced by the textarea's aria-describedby.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
}
