@implements IDisposable
@* ── The Po shell header (Po web standard) ─────────────────────────────────────
   One header on every page, signed in and out: the app name upper-left (`po-header__title`),
   the email or the Sign-in button plus the settings gear upper-right (`po-header__actions`).
   The layout of those three comes from po-tokens.css, which is the same file in every Po app;
   this component's scoped CSS only places the route links between them. The account menu
   that used to hang off an initial-badge is gone: Catalog, the dev personas and Logout live
   on /settings, behind the one gear. Below 640px the links drop out of the header because
   BottomNav carries them. *@
<header class="po-header navmenu">
    <div class="navmenu__start">
        <a class="po-header__title" href="/">
            <span class="navmenu__glyph" aria-hidden="true">PL</span>
            <span>PoLocalCompare</span>
        </a>

        @* ── USING MOCK DATA marker (standards §7) — shown when UseRealAi is off ──
           A compact chip beside the name. The visible "MOCK" is aria-hidden; the full sentence
           is in the title and a visually-hidden span, so the literal "USING MOCK DATA" stays in
           the DOM. Browser (WebGPU) models run in this tab and are never mocked. *@
        @if (_usingMockData)
        {
            <span class="navmenu__mock-chip" role="status" title="@MockDataText">
                <span aria-hidden="true">MOCK</span>
                <span class="visually-hidden">@MockDataText</span>
            </span>
        }
    </div>

    <nav class="navmenu__nav" aria-label="Main">
        <ul class="navmenu__links">
            <li>
                <NavLink class="navmenu__link" href="" Match="NavLinkMatch.All">Compare</NavLink>
            </li>
            <li>
                <NavLink class="navmenu__link" href="tournament">
                    <span class="navmenu__link-text--long">Tournament</span>
                    <span class="navmenu__link-text--short">Bracket</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="navmenu__link" href="leaderboard">
                    <span class="navmenu__link-text--long">Leaderboard</span>
                    <span class="navmenu__link-text--short">Ranks</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="navmenu__link" href="archive">Archive</NavLink>
            </li>
        </ul>
    </nav>

    @* Nothing session-shaped until /auth/me has answered: the first render ran before it, and a
       signed-in visitor used to see Sign in flash and then swap for their identity. *@
    <div class="po-header__actions">
        @if (_identityResolved && _identity is null)
        {
            <MicrosoftSignInButton Size="MicrosoftSignInSize.Small" Label="Sign in" OnClick="LoginWithMicrosoft" />
            @if (_allowGuest)
            {
                <button type="button" class="po-btn po-btn--sm po-btn--warn navmenu__guest" @onclick="LoginAsGuest">Guest</button>
            }
        }
        else if (_identity is not null)
        {
            <span class="po-header__email" title="@_identity">@_identity</span>
        }
        <a class="po-header__settings" href="/settings" aria-label="Settings" title="Settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </a>
    </div>
</header>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment { get; set; } = default!;

    private const string MockDataText =
        "USING MOCK DATA — Features:UseRealAi is off. Remote and Ollama responses are simulated.";

    private string? _identity;

    /// <summary>False until the first /auth/me answer; the session controls render after it.</summary>
    private bool _identityResolved;
    private bool _usingMockData;
    private bool _allowGuest;

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;

        var allowGuestByConfig = string.Equals(Config["Auth:AllowGuest"], "true", StringComparison.OrdinalIgnoreCase);
        var isProduction = string.Equals(HostEnvironment.Environment, "Production", StringComparison.OrdinalIgnoreCase);
        _allowGuest = allowGuestByConfig && !isProduction;

        _identity = await AccountMenu.ResolveIdentityAsync(AuthState);
        _identityResolved = true;

        var useRealAi = Config["Features:UseRealAi"];
        _usingMockData = !bool.TryParse(useRealAi, out var flag) || !flag;
    }

    private void LoginWithMicrosoft()
        => Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private void LoginAsGuest()
        => Nav.NavigateTo($"auth/login/fake?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private void OnAuthStateChanged(Task<AuthenticationState> _)
        => InvokeAsync(async () =>
        {
            _identity = await AccountMenu.ResolveIdentityAsync(AuthState);
            _identityResolved = true;
            StateHasChanged();
        });

    public void Dispose() => AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
}
