@implements IDisposable
<nav class="navmenu">
    <div class="navmenu__inner">
        @* aria-label, not the visible wordmark, carries the accessible name: between 768 and
           992px the wordmark is hidden to buy the bar room (rule in NavMenu.razor.css) and the
           mark itself is decorative. *@
        <BrandMark Size="BrandMarkSize.Small" Href="" AccessibleLabel="PoLocalCompare home" AdditionalClass="navmenu__brand" />

        @* ── USING MOCK DATA marker (standards §7) — shown when UseRealAi is off ──
           A compact chip beside the brand rather than a full-width red row above the bar. The
           visible "MOCK" is aria-hidden; the full sentence is in the title for sighted users and
           in a visually-hidden span for screen readers, so the literal "USING MOCK DATA" stays
           in the DOM. The wording names which inference paths are simulated on purpose: browser
           (WebGPU) models run in this tab and are never mocked. See MockInferenceProxy. *@
        @if (_usingMockData)
        {
            <span class="navmenu__mock-chip" role="status" title="@MockDataText">
                <span aria-hidden="true">MOCK</span>
                <span class="visually-hidden">@MockDataText</span>
            </span>
        }

        @* No hamburger, and since 2026-10-26 one row at every width. Below 768px the brand is
           its mark alone, the identity badge its initial, and the two long labels have short
           forms — that is what fits four links on a 360px bar, where they used to be a second
           row costing every phone page 44px. Exactly one label form is displayed at a time, so
           the accessible name is always the visible word (SC 2.5.3). *@
        <div class="navmenu__collapse">
            <ul class="navmenu__links">
                <li>
                    <NavLink class="navmenu__link" href="" Match="NavLinkMatch.All">
                        <span class="navmenu__link-text">Compare</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="tournament">
                        <span class="navmenu__link-text navmenu__link-text--long">Tournament</span>
                        <span class="navmenu__link-text navmenu__link-text--short">Bracket</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="leaderboard">
                        <span class="navmenu__link-text navmenu__link-text--long">Leaderboard</span>
                        <span class="navmenu__link-text navmenu__link-text--short">Ranks</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="archive">
                        <span class="navmenu__link-text">Archive</span>
                    </NavLink>
                </li>
                @* Catalog is not a top-nav link: it is the lowest-traffic route and tooling
                   rather than a primary flow. It lives in the user menu (below), which is
                   reachable at every width including phones. *@
            </ul>

            @* ── Live activity ticker ──────────────────────────────────────
               Polite, not assertive: duels finish while the user is reading, and an assertive
               region would interrupt them every time one did. One grouped chip — "N running ·
               M awaiting" — linking to the Archive, where an unjudged duel carries its own Judge
               button. Nothing to say renders nothing at all. *@
            @if (Ticker.RunningCount > 0 || Ticker.AwaitingVerdictCount > 0)
            {
                <div class="navmenu__ticker" role="status" aria-live="polite" aria-label="Live duel activity">
                    <a href="archive" class="navmenu__ticker-pill navmenu__ticker-pill--combined"
                       title="@TickerSummaryTitle()">
                        @if (Ticker.RunningCount > 0)
                        {
                            <span class="navmenu__ticker-pulse" aria-hidden="true"></span>
                            <span class="navmenu__ticker-count">@Ticker.RunningCount</span>
                            <span class="visually-hidden">running</span>
                        }
                        @if (Ticker.RunningCount > 0 && Ticker.AwaitingVerdictCount > 0)
                        {
                            <span class="navmenu__ticker-sep" aria-hidden="true">·</span>
                        }
                        @if (Ticker.AwaitingVerdictCount > 0)
                        {
                            <span aria-hidden="true">⚖</span>
                            <span class="navmenu__ticker-count">@Ticker.AwaitingVerdictCount</span>
                            <span class="visually-hidden">awaiting judgment</span>
                        }
                    </a>
                </div>
            }

            @* ── User identity / auth (standards §6) ── *@
            @* Nothing until the session is known. The first render ran before /auth/me answered,
               so a signed-in visitor saw Sign in + Guest flash and then swap for their badge —
               measured as a layout shift on every route. *@
            <div class="navmenu__auth">
                @if (_identityResolved && _identity is null)
                {
                    @* Same control as the Login card, just sized small so it sits in the navbar. *@
                    <MicrosoftSignInButton Size="MicrosoftSignInSize.Small"
                                            Label="Sign in"
                                            OnClick="LoginWithMicrosoft" />
                    @if (_allowGuest)
                    {
                        <button class="po-btn po-btn--sm po-btn--warn" @onclick="LoginAsGuestAsync">
                            Guest
                        </button>
                    }
                }

                @* ── One menu for everything session-shaped ──
                   Native <details>/<summary>: keyboard operable with no script, and it works the
                   same inside the phone drawer as on the desktop bar — which is what makes
                   /catalog reachable below 768px. Theme and sound stay available signed out;
                   the trigger is the identity badge when signed in and a gear when not.
                   Closing: Escape (OnMenuKeyDown) and any navigation (Catalog) re-key the
                   element, which recreates it closed. The two toggles deliberately leave it
                   open so the new state is visible where it was changed. *@
                @if (_identityResolved)
                {
                <details class="navmenu__menu" @key="_menuKey" @onkeydown="OnMenuKeyDown">
                    <summary class="navmenu__menu-trigger" @ref="_menuTrigger" aria-label="@MenuLabel">
                        @if (_identity is not null)
                        {
                            @* Split at the '@' so the badge can drop the DOMAIN on a narrow screen
                               instead of ellipsising mid-string; the local part is the identifying
                               half. The full value stays in the title either way. *@
                            @* The initial replaces the name below 768px; the summary's aria-label
                               carries the full identity at every width. *@
                            <span class="navmenu__user-badge @(_isGuest ? "navmenu__user-badge--guest" : "navmenu__user-badge--oauth")"
                                  title="@(_identity + (_isGuest ? " (guest session)" : " (signed in via Microsoft)"))">
                                <span class="navmenu__user-initial" aria-hidden="true">@IdentityInitial</span><span class="navmenu__user-badge-name">@IdentityLocalPart</span>@if (IdentityDomain is not null)
                                {
                                    <span class="navmenu__user-badge-domain">@IdentityDomain</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="navmenu__menu-glyph" aria-hidden="true">⚙</span>
                        }
                        <span class="navmenu__menu-caret" aria-hidden="true">▾</span>
                    </summary>

                    <div class="navmenu__menu-panel">
                        @* Cycles System → Light → Dark. The accessible name carries the state; the
                           visible state word is aria-hidden so it is not read twice. *@
                        <button type="button"
                                class="navmenu__menu-item navmenu__theme-toggle"
                                @onclick="CycleThemeAsync"
                                title="@ThemeTitle"
                                aria-label="@ThemeTitle">
                            <span class="navmenu__menu-glyph" aria-hidden="true">@ThemeGlyph</span>
                            <span>Theme</span>
                            <span class="navmenu__menu-state" aria-hidden="true">@ThemeLabel</span>
                        </button>

                        @* aria-pressed = sound on. The name stays "Sound" so the pressed state is
                           the only thing that changes. *@
                        <button type="button"
                                class="navmenu__menu-item"
                                @onclick="ToggleSoundAsync"
                                aria-pressed="@(_soundOn ? "true" : "false")">
                            <span class="navmenu__menu-glyph" aria-hidden="true">@(_soundOn ? "🔊" : "🔇")</span>
                            <span>Sound</span>
                            <span class="navmenu__menu-state" aria-hidden="true">@(_soundOn ? "On" : "Off")</span>
                        </button>

                        @if (_identity is not null)
                        {
                            <NavLink class="navmenu__menu-item" href="catalog"
                                     title="Add browser or Ollama models to the catalog">
                                <span class="navmenu__menu-glyph" aria-hidden="true">🧪</span>
                                <span>Catalog</span>
                            </NavLink>
                            <button type="button"
                                    class="navmenu__menu-item navmenu__menu-item--logout"
                                    @onclick="LogoutAsync">
                                <span class="navmenu__menu-glyph" aria-hidden="true">⎋</span>
                                <span>Logout</span>
                            </button>
                        }
                    </div>
                </details>
                }
            </div>
        </div>
    </div>
</nav>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment { get; set; } = default!;
    [Inject] private ThemeService Theme { get; set; } = default!;
    [Inject] private LobbyTickerService Ticker { get; set; } = default!;
    [Inject] private AudioService Audio { get; set; } = default!;

    private const string MockDataText =
        "USING MOCK DATA — Features:UseRealAi is off. Remote and Ollama responses are simulated.";


    // Bumped to recreate the <details> closed: Blazor cannot own its `open` attribute (the
    // browser toggles it), but it can replace the element.
    private int _menuKey;
    private bool _refocusTrigger;
    private ElementReference _menuTrigger;
    private bool _soundOn = true;

    private string MenuLabel => _identity is null ? "Settings" : $"Account menu for {_identity}";
    private string? _identity;
    private bool _isGuest;

    /// <summary>False until the first /auth/me answer; the session controls render after it.</summary>
    private bool _identityResolved;

    private string IdentityInitial =>
        IdentityLocalPart.Length > 0 ? IdentityLocalPart[..1].ToUpperInvariant() : "?";

    /// <summary>
    /// The identity up to and excluding the first '@' — the whole value when there is none
    /// (a guest name, or a UPN that is not email-shaped). This is the half worth keeping when
    /// the badge has to shed width.
    /// </summary>
    private string IdentityLocalPart =>
        _identity is null ? string.Empty
        : _identity.IndexOf('@') is var at && at > 0 ? _identity[..at]
        : _identity;

    /// <summary>
    /// The '@domain' remainder, or null when the identity has no '@'. Rendered in its own span
    /// so CSS can hide it on a narrow screen without the string being cut mid-word.
    /// </summary>
    private string? IdentityDomain =>
        _identity is not null && _identity.IndexOf('@') is var at && at > 0 && at < _identity.Length - 1
            ? _identity[at..]
            : null;
    private bool _usingMockData;
    private bool _allowGuest;
    private AppTheme _theme = AppTheme.System;


    // Rendered as a string, not a bool: Blazor treats a bool-valued attribute as an HTML
    // boolean attribute and omits it entirely when false, which would leave the collapsed
    // menu with no aria-expanded at all.

    private string ThemeGlyph => _theme switch
    {
        AppTheme.Light => "☀",   // sun
        AppTheme.Dark => "☽",    // moon
        _ => "◑",                // half-filled circle: following the system
    };

    private string ThemeLabel => _theme switch
    {
        AppTheme.Light => "Light",
        AppTheme.Dark => "Dark",
        _ => "Auto",
    };

    private string ThemeTitle => $"Theme: {ThemeLabel}. Activate to switch.";

    // ── Live ticker ──────────────────────────────────────────────────────────

    /// <summary>Tooltip for the grouped activity pill. A screen reader hears both counts
    /// from the visually-hidden labels; the tooltip is the same sentence for sighted users.</summary>
    private string TickerSummaryTitle()
    {
        var parts = new List<string>();
        if (Ticker.RunningCount > 0) parts.Add($"{Ticker.RunningCount} running");
        if (Ticker.AwaitingVerdictCount > 0) parts.Add($"{Ticker.AwaitingVerdictCount} awaiting judgment");
        return string.Join(" — ", parts);
    }

    private void OnTickerChanged() => InvokeAsync(StateHasChanged);


    // ── User menu ────────────────────────────────────────────────────────────

    private void CloseMenu() => _menuKey++;

    private void OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        CloseMenu();
        _refocusTrigger = true;   // the recreated summary, once it exists — see OnAfterRenderAsync
    }

    // Collapses the phone drawer too. It used to close only the user menu, and the drawer sits
    // in the page flow, so every route opened from it started pushed below an open menu.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(() => { CloseMenu(); StateHasChanged(); });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_refocusTrigger) return;
        _refocusTrigger = false;
        await _menuTrigger.FocusAsync();
    }

    private async Task ToggleSoundAsync() => _soundOn = !await Audio.SetMutedAsync(_soundOn);

    private async Task CycleThemeAsync()
    {
        _theme = _theme switch
        {
            AppTheme.System => AppTheme.Light,
            AppTheme.Light => AppTheme.Dark,
            _ => AppTheme.System,
        };
        await Theme.SetAsync(_theme);
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;

        var allowGuestByConfig = string.Equals(Config["Auth:AllowGuest"], "true", StringComparison.OrdinalIgnoreCase);
        var isProduction = string.Equals(HostEnvironment.Environment, "Production", StringComparison.OrdinalIgnoreCase);
        _allowGuest = allowGuestByConfig && !isProduction;

        await RefreshIdentityAsync();

        // theme.js already painted before Blazor booted; this only syncs the button's label
        // to what it chose, so the two cannot disagree.
        _theme = await Theme.GetAsync();
        _soundOn = !await Audio.IsMutedAsync();
        Nav.LocationChanged += OnLocationChanged;

        var useRealAi = Config["Features:UseRealAi"];
        _usingMockData = !bool.TryParse(useRealAi, out var flag) || !flag;

        // Not awaited: connecting the hub and seeding the pending count must not hold up the
        // nav bar, which is the first thing rendered on every page. It starts only after the
        // BFF identity resolves; anonymous startup previously emitted an expected 401 for both
        // the seed request and SignalR negotiation on every visit to the login page.
        Ticker.OnChanged += OnTickerChanged;
        StartTickerWhenAuthenticated();
    }

    /// <summary>Resolves the current identity from the BFF session (/auth/me via the state provider).</summary>
    private async Task RefreshIdentityAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
            {
                _identity = state.User.FindFirst("preferred_username")?.Value
                         ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                         ?? state.User.Identity.Name;
                _isGuest = _identity?.StartsWith("GUEST", StringComparison.OrdinalIgnoreCase) == true
                        || state.User.IsInRole("Guest");
            }
            else
            {
                _identity = null;
                _isGuest = false;
            }
        }
        catch
        {
            _identity = null;
            _isGuest = false;
        }

        _identityResolved = true;
    }

    private void LoginWithMicrosoft()
        => Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private void LoginAsGuestAsync()
        => Nav.NavigateTo($"auth/login/fake?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}", forceLoad: true);

    private void StartTickerWhenAuthenticated()
    {
        if (_identity is not null)
            _ = Ticker.EnsureStartedAsync(Nav.BaseUri);
    }

    private async Task LogoutAsync()
    {
        try { await Http.PostAsync("auth/logout", null); }
        catch { /* clear UI regardless */ }
        // Full reload re-evaluates the (now cleared) session and renders the Login view.
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> _)
        => InvokeAsync(async () =>
        {
            await RefreshIdentityAsync();
            StartTickerWhenAuthenticated();
            StateHasChanged();
        });

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        Ticker.OnChanged -= OnTickerChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
