@implements IDisposable
@* ── The Po shell header (Po web standard, AGENTS.md) ──────────────────────────
   One header on every page, signed in and out, the sign-in page included: the app name upper-left
   (`po-header__title`), then upper-right the signed-in email (`po-header__email`, which opens the
   account menu: Sign out, plus the dev personas outside Production) or, signed out, the one Sign in
   button (`po-link-btn filled small`; not on /login itself, whose card is the sign-in). No settings
   gear: /settings was removed on 2026-11-19 and its switches are fixed in prefs.js (a deviation listed
   in AGENTS.md). Below 640px the route links drop out of the header because BottomNav carries them. *@
<header class="po-header navmenu">
    <div class="navmenu__start">
        <a class="po-header__title" href="/">
            <span class="navmenu__glyph" aria-hidden="true">PL</span>
            <span>PoLocalCompare</span>
        </a>

        @* ── USING MOCK DATA marker (standards §7) — shown when UseRealAi is off ──
           A compact chip beside the name. The visible "MOCK" is aria-hidden; the full sentence
           is in the title and a visually-hidden span, so the literal "USING MOCK DATA" stays in
           the DOM. Browser (WebGPU) models run in this tab and are never mocked. *@
        @if (_usingMockData)
        {
            <span class="navmenu__mock-chip" role="status" title="@MockDataText">
                <span aria-hidden="true">MOCK</span>
                <span class="visually-hidden">@MockDataText</span>
            </span>
        }
    </div>

    @* Signed out, every route but /login and /diag asks for a session, so the links are not offered. *@
    @if (_identity is not null)
    {
        <nav class="navmenu__nav" aria-label="Main">
            <ul class="navmenu__links">
                <li>
                    <NavLink class="navmenu__link" href="" Match="NavLinkMatch.All">Compare</NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="tournament">
                        <span class="navmenu__link-text--long">Tournament</span>
                        <span class="navmenu__link-text--short">Bracket</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="leaderboard">
                        <span class="navmenu__link-text--long">Leaderboard</span>
                        <span class="navmenu__link-text--short">Ranks</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="navmenu__link" href="archive">Archive</NavLink>
                </li>
            </ul>
        </nav>
    }

    @* Nothing session-shaped until /auth/me has answered: the first render ran before it, and a
       signed-in visitor used to see Sign in flash and then swap for their identity. *@
    <div class="po-header__actions">
        @if (_identityResolved && _identity is null)
        {
            @if (!OnLogin)
            {
                <a class="po-link-btn filled small" href="@LoginHref">Sign in</a>
            }
        }
        else if (_identity is not null)
        {
            @* A native disclosure: keyboard-operable (Enter/Space on the summary) with no script. *@
            <details class="navmenu__account">
                <summary class="po-header__email navmenu__account-toggle" title="@_identity">@_identity</summary>
                <div class="navmenu__account-menu">
                    @if (!_isProduction)
                    {
                        <span class="navmenu__account-label">Dev persona</span>
                        @foreach (var persona in AccountMenu.DevPersonas)
                        {
                            <button type="button" class="po-btn po-btn--sm po-btn--secondary"
                                    @onclick="() => SwitchDevPersona(persona)">@persona</button>
                        }
                    }
                    <button type="button" class="po-btn po-btn--sm po-btn--secondary" @onclick="LogoutAsync">Sign out</button>
                </div>
            </details>
        }
    </div>
</header>

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment { get; set; } = default!;
    [Inject] private DuelApiClient ApiClient { get; set; } = default!;

    private const string MockDataText =
        "USING MOCK DATA — Features:UseRealAi is off. Remote and Ollama responses are simulated.";

    private string? _identity;

    /// <summary>False until the first /auth/me answer; the session controls render after it.</summary>
    private bool _identityResolved;
    private bool _usingMockData;
    private bool _isProduction;

    private bool OnLogin => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Equals("login", StringComparison.OrdinalIgnoreCase);

    /// <summary>The sign-in page, coming back here afterwards.</summary>
    private string LoginHref => $"login?returnUrl={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}";

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;
        Nav.LocationChanged += OnLocationChanged;

        _isProduction = string.Equals(HostEnvironment.Environment, "Production", StringComparison.OrdinalIgnoreCase);

        _identity = await AccountMenu.ResolveIdentityAsync(AuthState);
        _identityResolved = true;

        var useRealAi = Config["Features:UseRealAi"];
        _usingMockData = !bool.TryParse(useRealAi, out var flag) || !flag;
    }

    /// <summary>Development only: sign in again as another test user, staying on this page.</summary>
    private void SwitchDevPersona(string persona)
    {
        DevFakeUserHandler.ActiveFakeUser = persona;
        var here = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        Nav.NavigateTo($"auth/login/fake?user={Uri.EscapeDataString(persona)}&returnUrl={here}", forceLoad: true);
    }

    private async Task LogoutAsync()
    {
        DevFakeUserHandler.ActiveFakeUser = null;
        try { await ApiClient.LogoutAsync(); }
        catch (HttpRequestException) { /* the reload below shows the signed-out state regardless */ }
        // A full reload re-evaluates the (now cleared) session.
        Nav.NavigateTo("/", forceLoad: true);
    }

    private void OnAuthStateChanged(Task<AuthenticationState> _)
        => InvokeAsync(async () =>
        {
            _identity = await AccountMenu.ResolveIdentityAsync(AuthState);
            _identityResolved = true;
            StateHasChanged();
        });

    // The Sign in button's return address and its absence on /login follow the route.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
