@page "/not-found"
@layout MainLayout

<PageTitle>Page not found · PoLocalCompare</PageTitle>

<div class="po-page">
    <EmptyState Icon="404"
                IsPageHeading="true"
                Title="Page not found"
                Hint="The page you're looking for doesn't exist or has been moved."
                Actions="@(new[] { new EmptyStateAction("Back to Compare", "/", EmptyStateActionVariant.Ghost) })" />
</div>
