@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Enums
@using PoLocalCompare.Client.Services
@using System.Globalization

@* Speed, cost and the green figures are what a duel is judged on; the shape-of-the-output
   numbers are diagnostics and wait behind a disclosure. A failed result renders nothing at
   all — every metric here reads zero on failure, and the Arena's failure card is the one
   place that explains why.

   While the side is still streaming (Live set, no Result yet) it carries what the separate
   TokenRace panel used to: a progress track scaled to the front-runner and the live token
   count and tok/s. That panel restated both model names and both lanes above the two
   panels that already name them; this is the same number, under the output it describes. *@
<div class="telemetry-hud">
    @if (Result is null && Live is not null)
    {
        @* Decorative: every number it encodes is in the readout beside it. *@
        <div class="telemetry-hud__track" aria-hidden="true">
            <div class="telemetry-hud__fill @(Live.Status == DuelStatus.Failed ? "telemetry-hud__fill--failed" : "")"
                 style="--pos: @Progress.ToString("F1", CultureInfo.InvariantCulture)%"></div>
        </div>
        <div class="telemetry-hud__grid">
            <div class="telemetry-hud__item">
                <span class="telemetry-hud__label">Tokens</span>
                <span class="telemetry-hud__value">@Live.TokenCount.ToString("N0")</span>
            </div>
            <div class="telemetry-hud__item">
                <span class="telemetry-hud__label">Token Velocity</span>
                <span class="telemetry-hud__value">@((Live.TokenVelocity ?? 0).ToString("F1", CultureInfo.InvariantCulture)) tok/s</span>
            </div>
        </div>
        @* tok/s over the run so far. Decorative: the current figure is in the readout above. *@
        <canvas id="@_sparkId" class="telemetry-hud__spark" aria-hidden="true"></canvas>
    }
    else if (Result is null)
    {
        <div class="telemetry-hud__pending">Awaiting results…</div>
    }
    else if (!Result.IsFailure)
    {
        <div class="telemetry-hud__grid">
            <div class="telemetry-hud__item">
                <span class="telemetry-hud__label">Token Velocity</span>
                <span class="telemetry-hud__value">@Result.TokenVelocity.ToString("F1") tok/s</span>
            </div>
            <div class="telemetry-hud__item">
                <span class="telemetry-hud__label">Total Time</span>
                <span class="telemetry-hud__value">@FormatMs(Result.TotalDurationMs)</span>
            </div>

            @if (Result.ApiCostUsd.HasValue)
            {
                <div class="telemetry-hud__item">
                    <span class="telemetry-hud__label">API Cost</span>
                    <span class="telemetry-hud__value telemetry-hud__value--yellow">$@Result.ApiCostUsd.Value.ToString("F6")</span>
                </div>
            }

        </div>

        <details class="telemetry-hud__more">
            <summary class="telemetry-hud__more-summary">More metrics</summary>
            <div class="telemetry-hud__grid">
                <div class="telemetry-hud__item">
                    <span class="telemetry-hud__label">Warm-up</span>
                    <span class="telemetry-hud__value">@FormatMs(Result.WarmUpDurationMs)</span>
                </div>
                <div class="telemetry-hud__item">
                    <span class="telemetry-hud__label">Tokens</span>
                    <span class="telemetry-hud__value">@Result.TokenCount.ToString("N0")</span>
                </div>
                @if (Result.PromptTokenCount.HasValue)
                {
                    <div class="telemetry-hud__item">
                        <span class="telemetry-hud__label">Prompt Tokens</span>
                        <span class="telemetry-hud__value">@Result.PromptTokenCount.Value.ToString("N0")</span>
                    </div>
                }
                @if (Result.ReasoningTokenCount.HasValue)
                {
                    <div class="telemetry-hud__item">
                        <span class="telemetry-hud__label">Reasoning Tokens</span>
                        <span class="telemetry-hud__value">@Result.ReasoningTokenCount.Value.ToString("N0")</span>
                    </div>
                }
                <div class="telemetry-hud__item">
                    <span class="telemetry-hud__label">Completion</span>
                    <span class="telemetry-hud__value">@(Result.WasTruncated ? "Truncated" : Result.FinishReason ?? "Unknown")</span>
                </div>
                <div class="telemetry-hud__item">
                    <span class="telemetry-hud__label">Output Size</span>
                    <span class="telemetry-hud__value">@FormatBytes(Result.HtmlOutputSizeBytes)</span>
                </div>
                <div class="telemetry-hud__item">
                    <span class="telemetry-hud__label">Char Density</span>
                    <span class="telemetry-hud__value">@Result.CharacterDensityRatio.ToString("P1")</span>
                </div>

                @if (Result.EnergyWh.HasValue)
                {
                    <div class="telemetry-hud__item">
                        <span class="telemetry-hud__label">Energy</span>
                        <span class="telemetry-hud__value telemetry-hud__value--green">@Result.EnergyWh.Value.ToString("F4") Wh</span>
                    </div>
                    <div class="telemetry-hud__item">
                        <span class="telemetry-hud__label">Energy Cost</span>
                        <span class="telemetry-hud__value">$@Result.EnergyCostUsd?.ToString("F6")</span>
                    </div>
                }
            </div>
        </details>
    }
</div>

@code {
    [Parameter] public DuelResultDto? Result { get; set; }

    /// <summary>This side's streaming telemetry while the duel runs; null once it has finished.</summary>
    [Parameter] public SideMetrics? Live { get; set; }

    /// <summary>Track position, 0–100, scaled to the front-runner by the page.</summary>
    [Parameter] public double Progress { get; set; }


    // Sits inside the Arena's render tree, which re-renders on a timer while streaming. Live is
    // a mutable object, so its values — not its reference — decide whether anything changed.
    private DuelResultDto? _lastResult;
    private (int, double?, DuelStatus, double)? _lastLive;
    private bool _renderDirty = true;

    protected override bool ShouldRender() => _renderDirty;

    protected override void OnParametersSet()
    {
        (int, double?, DuelStatus, double)? live = Live is null ? null : (Live.TokenCount, Live.TokenVelocity, Live.Status, Progress);
        _renderDirty = !ReferenceEquals(Result, _lastResult) || live != _lastLive;
        if (Live?.TokenVelocity is { } tps && live != _lastLive) RecordSample(tps);
        _lastLive = live;
        _lastResult = Result;
    }

    // ── Sparkline ────────────────────────────────────────────────────────────
    // A fixed ring of the latest tok/s readings, handed to sparkline.js as a span after each
    // render that changed them. Fixed size, so a long run costs the same as a short one.

    private const int SparkCapacity = 60;
    private readonly double[] _samples = new double[SparkCapacity];
    private readonly double[] _ordered = new double[SparkCapacity];
    private int _sampleCount;
    private int _sampleNext;
    private bool _sparkDirty;
    private readonly string _sparkId = $"spark-{Guid.NewGuid():N}";

    private void RecordSample(double tps)
    {
        _samples[_sampleNext] = tps;
        _sampleNext = (_sampleNext + 1) % SparkCapacity;
        _sampleCount = Math.Min(_sampleCount + 1, SparkCapacity);
        _sparkDirty = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_sparkDirty || _sampleCount < 2 || Live is null) return;
        _sparkDirty = false;

        // Oldest first: the tail of the ring, then its head.
        var start = _sampleCount < SparkCapacity ? 0 : _sampleNext;
        for (var i = 0; i < _sampleCount; i++) _ordered[i] = _samples[(start + i) % SparkCapacity];

        try
        {
            await Sparkline.EnsureLoadedAsync();
            Sparkline.Draw(_sparkId, _ordered.AsSpan(0, _sampleCount));
        }
        catch (System.Runtime.InteropServices.JavaScript.JSException)
        {
            // Decoration: the readout above already carries the number.
        }
    }

    private static string FormatMs(long ms)
    {
        if (ms >= 60_000)
            return $"{ms / 60_000}m {(ms % 60_000) / 1000}s";
        if (ms >= 1_000)
            return $"{ms / 1000.0:F1}s";
        return $"{ms}ms";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / (1024.0 * 1024):F1} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} B";
    }
}
