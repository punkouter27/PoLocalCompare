<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Required by the [JSImport] source generator (Services/Sparkline.cs). No unsafe code is
         written by hand. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Standards §6.6: the assembly is trim-annotated (IsTrimmable + analyzer), but the app
         publishes untrimmed: the Router's NotFoundPage instantiates components via reflection,
         which the IL trimmer strips in Release publish (CtorNotLocated at runtime → the Blazor
         view tree fails to mount).

         MEASURED 2026-08-23 (Release publish, gzipped — what a browser actually downloads):
           untrimmed  11.99 MB across 219 files
           trimmed     6.18 MB across  96 files   -> 48% smaller
         A runtime audit measured 3.9-11.7 s to first heading across the app's routes, and that
         payload is the reason.

         Radzen.Blazor has been removed (for the second time, on 2026-09-26: +3.26 MB, +25.7% of
         the download, for two grids and one chart). The Archive and Catalog are semantic
         .po-tables and the model profile's rating curve is inline SVG.

         So the Router's NotFoundPage is the ONLY trimming blocker. A trimmed publish builds and
         boots — the shell mounts, routing works, the nav renders live API data — but the
         authenticated surface has not been exercised under trimming, and NotFoundPage is
         exactly the kind of thing that fails there. Resolve it (a DynamicDependency attribute
         or an explicit TrimmerRootDescriptor), verify a signed-in session against a trimmed
         build, then flip this on. Do not flip it on the strength of the publish succeeding —
         it succeeds either way. -->
    <IsTrimmable>true</IsTrimmable>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <!-- Surface trim diagnostics as warnings without failing the build: Blazor-generated Razor code
         and System.Net.Http.Json emit IL2xxx/IL3xxx trim-analyzer warnings that cannot be fixed in
         this app (it ships untrimmed-by-default anyway). Scoped to trim codes only —
         every other warning is still an error per TreatWarningsAsErrors. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL2046;IL2057;IL2072;IL2075;IL2087;IL2091;IL2104;IL2110;IL2111;IL3050;IL3051;IL3052;IL3053</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoLocalCompare.Shared\PoLocalCompare.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\models\**\*" CopyToPublishDirectory="Never" />
    <!-- Development-only config: enables guest auth in non-Production; never deployed -->
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
