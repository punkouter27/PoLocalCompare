@using PoLocalCompare.Shared.Prompts
@using PoLocalCompare.Client.Services
@inject AudioService AudioService

@* Prompt sourcing for the Compare page: a curated set, compiled in, so picking a prompt
   costs no network round-trip. The "your recent prompts" list that sat above the library
   was removed on 2026-08-23 along with its localStorage service. *@

<div class="prompt-picker">
    @* The library is a disclosure, not a wall. Eighteen cards rendered unconditionally sat
       between the textarea and the Compare button and were about half the page on both
       viewports — the textarea is the primary input, so the catalogue waits to be asked for. *@
    <div class="prompt-picker__section">
        <button type="button" class="po-btn po-btn--sm po-btn--secondary prompt-picker__disclosure"
                aria-expanded="@(_libraryOpen ? "true" : "false")"
                aria-controls="prompt-library"
                @onclick="@(() => { _ = AudioService.PlayTickAsync(); _libraryOpen = !_libraryOpen; })">
            <span aria-hidden="true">@(_libraryOpen ? "▾" : "▸")</span>
            @(_libraryOpen ? "Hide prompt library" : $"Browse prompt library ({PromptLibrary.All.Count})")
        </button>

        @if (_libraryOpen)
        {
        <div id="prompt-library">

        <div class="prompt-picker__filters" role="group" aria-label="Filter prompts by category">
            <button type="button"
                    class="po-btn po-btn--sm po-btn--chip"
                    aria-pressed="@(_category == AllCategories ? "true" : "false")"
                    @onclick="@(() => { _ = AudioService.PlayTickAsync(); _category = AllCategories; })">
                All (@PromptLibrary.All.Count)
            </button>
            @foreach (var category in PromptLibrary.Categories)
            {
                var count = PromptLibrary.InCategory(category).Count;
                <button type="button"
                        class="po-btn po-btn--sm po-btn--chip"
                        aria-pressed="@(_category == category ? "true" : "false")"
                        @onclick="@(() => { _ = AudioService.PlayTickAsync(); _category = category; })">
                    @category (@count)
                </button>
            }
        </div>

        <div class="prompt-picker__grid">
            @foreach (var template in PromptLibrary.InCategory(_category))
            {
                <button type="button"
                        class="prompt-picker__card @(IsCurrent(template.Text) ? "prompt-picker__card--active" : "")"
                        @onclick="() => SelectAsync(template.Text)">
                    <span class="prompt-picker__card-head">
                        <span class="prompt-picker__card-emoji" aria-hidden="true">@template.Emoji</span>
                        <span class="prompt-picker__card-title">@template.Title</span>
                        @if (template.SelfRunning)
                        {
                            <span class="prompt-picker__card-tag" title="Animates on its own — no interaction needed">auto</span>
                        }
                    </span>
                    <span class="prompt-picker__card-text">@Excerpt(template.Text)</span>
                </button>
            }
        </div>
        </div>
        }
    </div>
</div>

@code {
    private const string AllCategories = "All";

    [Parameter] public string? CurrentPrompt { get; set; }
    [Parameter] public EventCallback<string> OnPromptSelected { get; set; }

    private string _category = AllCategories;
    private bool _libraryOpen;

    // Picking a prompt answers the step, so the catalogue closes behind the choice.
    private void CloseLibrary() => _libraryOpen = false;

    private bool IsCurrent(string text) =>
        string.Equals(CurrentPrompt?.Trim(), text, StringComparison.Ordinal);

    private Task SelectAsync(string text)
    {
        _ = AudioService.PlayTickAsync();
        CloseLibrary();
        return OnPromptSelected.InvokeAsync(text);
    }

    private static string Excerpt(string text) =>
        text.Length <= 120 ? text : text[..120].TrimEnd() + "…";
}
