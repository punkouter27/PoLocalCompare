@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@* The sign-in page: the title and exactly one button (Po standard), in every environment. Signed-out
   visitors to any other page are sent here (RedirectToLogin) with ?returnUrl=, so the header's Sign in
   button is hidden only on this route and this card is the one sign-in control. Signed in, there is
   nothing to sign in to: it goes to returnUrl (or Compare). Outside Production the dev sign-in is the
   URL /auth/login/fake?returnUrl=/ (or a dev persona from the account menu), not a second button. *@

<PageTitle>Sign in · PoLocalCompare</PageTitle>

<div class="login">
    <div class="login__card">
        @* The page title: BrandMark (the navbar's logo glyph in its stacked, centre-aligned form)
           as the page's one h1. *@
        <h1 class="login__title"><BrandMark Size="BrandMarkSize.Large" /></h1>

        @* MicrosoftSignInButton. Below 768px the Login route used to drop the page
           into the navbar's 14px glyph; this takes the login-large 20px glyph
           instead, so the two buttons now look like two sizes of one control. *@
        <MicrosoftSignInButton OnClick="LoginWithMicrosoft" Label="Sign in with Microsoft" />
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(ReturnPath(), replace: true);
        }
    }

    // forceLoad: these are server BFF endpoints, not Blazor routes — the cookie is set server-side.
    private void LoginWithMicrosoft()
        => Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(ReturnPath())}", forceLoad: true);

    /// <summary>Where to land after signing in: a local path from ?returnUrl=, never another site.</summary>
    private string ReturnPath() =>
        ReturnUrl is { Length: > 0 } url && url.StartsWith('/') && !url.StartsWith("//", StringComparison.Ordinal)
            && !url.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            ? url
            : "/";
}
