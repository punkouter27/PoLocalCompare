@page "/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@* The sign-in page. Signed-out visitors to any other page are sent here (RedirectToLogin) with
   ?returnUrl=, so the header's Sign in button is hidden only on this route and this card is the one
   sign-in control. Signed in, there is nothing to sign in to: it goes to returnUrl (or Compare). *@
@inject IConfiguration Config
@inject IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>Sign in · PoLocalCompare</PageTitle>

<div class="login">
    <div class="login__card">
        @* BrandMark — the same logo glyph as the navbar but rendered as a stacked
           centre-aligned form. *@
        <BrandMark Size="BrandMarkSize.Large" />

        @* MicrosoftSignInButton. Below 768px the Login route used to drop the page
           into the navbar's 14px glyph; this takes the login-large 20px glyph
           instead, so the two buttons now look like two sizes of one control. *@
        <MicrosoftSignInButton OnClick="LoginWithMicrosoft" Label="Sign in with Microsoft" />

        @if (_allowGuest)
        {
            <div class="login__divider"><span>or</span></div>
            <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="lc-plain po-btn po-btn--secondary po-btn--block" Click="LoginAsGuest">
                Continue as Guest
            </RadzenButton>
        }
    </div>
</div>

@code {
    private bool _allowGuest;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(ReturnPath(), replace: true);
            return;
        }

        var allowGuestByConfig = string.Equals(Config["Auth:AllowGuest"], "true", StringComparison.OrdinalIgnoreCase);
        var isProduction = string.Equals(HostEnvironment.Environment, "Production", StringComparison.OrdinalIgnoreCase);
        _allowGuest = allowGuestByConfig && !isProduction;
    }

    // forceLoad: these are server BFF endpoints, not Blazor routes — the cookie is set server-side.
    private void LoginWithMicrosoft()
        => Nav.NavigateTo($"auth/login/microsoft?returnUrl={Uri.EscapeDataString(ReturnPath())}", forceLoad: true);

    private void LoginAsGuest()
        => Nav.NavigateTo($"auth/login/fake?returnUrl={Uri.EscapeDataString(ReturnPath())}", forceLoad: true);

    /// <summary>Where to land after signing in: a local path from ?returnUrl=, never another site.</summary>
    private string ReturnPath() =>
        ReturnUrl is { Length: > 0 } url && url.StartsWith('/') && !url.StartsWith("//", StringComparison.Ordinal)
            && !url.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            ? url
            : "/";
}
