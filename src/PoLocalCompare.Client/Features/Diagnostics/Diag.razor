@page "/diag"
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using PoLocalCompare.Client.Services
@using PoLocalCompare.Shared.DTOs
@inject HttpClient Http

<PageTitle>Diagnostics · PoLocalCompare</PageTitle>

<div class="po-page po-diag">
    <PageHeader Title="Diagnostics" Subtitle="Live status of the API, data stores, and AI inference services.">
        <Actions>
            <RadzenButton Text="@(_loading ? "Checking…" : "Refresh")" Icon="refresh"
                          ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                          Disabled="@_loading" IsBusy="@_loading" Click="@LoadAsync" />
        </Actions>
    </PageHeader>

    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" AllowClose="false" Title="The server did not answer">
            @_error
        </RadzenAlert>
    }
    else if (_report is not null)
    {
        <section class="po-diag__group" aria-label="API">
            <h2>API</h2>
            <div class="po-diag__card">
                <strong>PoLocalCompare API</strong>
                <span class="po-badge po-badge--ok">Reachable</span>
                <span>Build v@(_report.Version) · @(_report.Environment)</span>
            </div>
        </section>

        <section class="po-diag__group" aria-label="Data">
            <h2>Data</h2>
            @foreach (var s in _report.Stores)
            {
                <div class="po-diag__card">
                    <strong>@s.Name</strong>
                    <span class="po-badge po-badge--@(Badge(s.Status))">@s.Status</span>
                    <span>@s.Purpose</span>
                </div>
            }
        </section>

        <section class="po-diag__group" aria-label="Services">
            <h2>Services</h2>
            @foreach (var svc in _report.Services)
            {
                <div class="po-diag__card">
                    <strong>@svc.Name</strong>
                    <span class="po-badge po-badge--@(Badge(svc.Status))">@svc.Status</span>
                    <span>@svc.Purpose</span>
                </div>
            }
        </section>
    }
</div>

@code {
    private DiagReportDto? _report;
    private string? _error;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _report = await Http.GetFromJsonAsync("/api/diag", ClientJson.Default.DiagReportDto);
        }
        catch (Exception)
        {
            _error = "Could not reach /api/diag. Try Refresh in a moment.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Badge(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "ok",
        "degraded" => "warn",
        _ => "bad",
    };
}
