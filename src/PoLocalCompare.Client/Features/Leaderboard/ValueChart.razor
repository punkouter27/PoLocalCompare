@using System.Globalization
@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Presentation

@* ── ELO against cost ─────────────────────────────────────────────────────
   The table ranks; this answers the other question — which model is worth paying for. Inline
   SVG, no chart library and no canvas (see the motion note in CLAUDE.md), same approach as the
   profile's rating curve. The table underneath is the accessible view of the same numbers, so
   the SVG is one labelled image and each dot is a real link to that model's profile.

   Every <text> sits inside a <g>: at the top level of a Razor code block `<text>` is Razor's
   own pseudo-tag, not the SVG element. *@
@if (_layout is { } chart)
{
    <figure class="value-chart">
        <figcaption class="po-section-title">Rating for the money</figcaption>
        <p class="po-hint value-chart__legend">
            Higher is stronger, further left is cheaper.
            <span class="value-chart__key"><span class="value-chart__swatch value-chart__swatch--frontier" aria-hidden="true"></span>best rating at its price</span>
            <span class="value-chart__key"><span class="value-chart__swatch" aria-hidden="true"></span>a cheaper model is rated higher</span>
        </p>
        <svg class="value-chart__svg" viewBox="0 0 @N(ValueChartLayout.Width) @N(ValueChartLayout.Height)"
             role="img" aria-label="@Summary(chart)">
            @foreach (var (elo, y) in chart.EloTicks)
            {
                <g>
                    <line class="value-chart__grid" x1="@N(ValueChartLayout.GridLeft)" x2="@N(ValueChartLayout.PlotRight)" y1="@N(y)" y2="@N(y)" />
                    <text class="value-chart__tick" x="@N(ValueChartLayout.GridLeft - 8)" y="@N(y + 4)" text-anchor="end">@elo</text>
                </g>
            }
            @foreach (var (label, x) in chart.CostTicks)
            {
                <g>
                    <line class="value-chart__grid" x1="@N(x)" x2="@N(x)" y1="@N(ValueChartLayout.PlotTop)" y2="@N(ValueChartLayout.PlotBottom)" />
                    <text class="value-chart__tick" x="@N(x)" y="@N(ValueChartLayout.PlotBottom + 18)" text-anchor="middle">@label</text>
                </g>
            }
            @if (chart.FreeLaneX is { } freeX)
            {
                <g>
                    <line class="value-chart__divider" x1="@N(chart.PlotLeft)" x2="@N(chart.PlotLeft)" y1="@N(ValueChartLayout.PlotTop)" y2="@N(ValueChartLayout.PlotBottom)" />
                    <text class="value-chart__tick" x="@N(freeX)" y="@N(ValueChartLayout.PlotBottom + 18)" text-anchor="middle">no API cost</text>
                </g>
            }
            <g>
                <text class="value-chart__tick" x="@N(ValueChartLayout.PlotRight)" y="@N(ValueChartLayout.Height - 4)" text-anchor="end">average API cost per duel (log scale)</text>
            </g>

            <polyline class="value-chart__frontier" points="@FrontierPath(chart)" />

            @foreach (var p in chart.Points)
            {
                <a href="@($"/model/{p.Entry.ModelId}")" class="value-chart__link">
                    <title>@Tooltip(p)</title>
                    <circle class="value-chart__hit" cx="@N(p.X)" cy="@N(p.Y)" r="12" />
                    <circle class="value-chart__dot @(p.OnFrontier ? "value-chart__dot--frontier" : "")" cx="@N(p.X)" cy="@N(p.Y)" r="5" />
                </a>
            }
            @{ var labelled = chart.Points.Where(p => p.OnFrontier).ToList(); }
            @for (var i = 0; i < labelled.Count; i++)
            {
                var p = labelled[i];
                // The frontier climbs to the right, so alternating above-left / below-right
                // keeps neighbouring names off each other. A name hung left of a point near
                // the left edge would run over the ELO axis labels, so it is pinned to the
                // plot's edge instead (width estimated at ~7 units a character).
                var above = i % 2 == 0;
                var pinned = above && p.X - 8 - p.Entry.DisplayName.Length * 7 < ValueChartLayout.GridLeft + 4;
                <g>
                    <text class="value-chart__label"
                          x="@N(pinned ? ValueChartLayout.GridLeft + 4 : p.X + (above ? -8 : 8))" y="@N(p.Y + (above ? -10 : 16))"
                          text-anchor="@(above && !pinned ? "end" : "start")" aria-hidden="true">@p.Entry.DisplayName</text>
                </g>
            }
        </svg>
    </figure>
}

@code {
    /// <summary>The rows the table is showing — the chart plots exactly those.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<LeaderboardEntryDto> Entries { get; set; } = [];

    private ValueChartLayout? _layout;

    protected override void OnParametersSet() => _layout = ValueChartLayout.Build(Entries);

    /// <summary>Invariant: an SVG coordinate written with a decimal comma is not a number.</summary>
    private static string N(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string FrontierPath(ValueChartLayout chart) =>
        string.Join(' ', chart.Points.Where(p => p.OnFrontier).Select(p => $"{N(p.X)},{N(p.Y)}"));

    private static string Cost(LeaderboardEntryDto e) =>
        e.AvgApiCostPerDuel is { } cost and > 0 ? $"${cost:F4} per duel" : "no API cost";

    private static string Tooltip(ValueChartPoint p) =>
        $"{p.Entry.DisplayName} — ELO {p.Entry.CurrentElo:F0}, {Cost(p.Entry)}" +
        (p.OnFrontier ? " — best rating at this price" : string.Empty);

    private static string Summary(ValueChartLayout chart) =>
        "Scatter plot of ELO against average API cost per duel. Best rating at each price: " +
        string.Join("; ", chart.Points.Where(p => p.OnFrontier)
            .Select(p => $"{p.Entry.DisplayName}, ELO {p.Entry.CurrentElo:F0}, {Cost(p.Entry)}")) + ".";
}
