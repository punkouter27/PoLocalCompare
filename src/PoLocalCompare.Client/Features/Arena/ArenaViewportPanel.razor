@using PoLocalCompare.Shared.DTOs
@using PoLocalCompare.Shared.Ids
@inject PreferencesService Prefs

@* One side of the Arena's viewports. Was previously inlined twice in Arena.razor with the
   only differences being the field name on the page (`_leftResult` vs `_rightResult`),
   the streaming HTML, the ELO shift, and the on-probe callback. Every other branch —
   failure, telemetry, view-source button, ELO badge — is identical, so it lifts cleanly.

   Two render branches: failure shows an `ArenaFailureCard` instead of the sandboxed
   viewport. The ELO shift rides on the viewport's WINNER/LOSER badge. The page passes the
   panel a single `Result` row; nothing on this component reads sibling state. *@

<div class="arena-panel__box @((Result?.IsFailure == true) ? "arena-panel__box--failed po-bg--err" : "") @(IsVerdictRecorded && WinnerModelId == PanelModelId ? "arena-panel__box--winner" : "") @(Reveal && IsVerdictRecorded && WinnerModelId == PanelModelId ? "arena-panel__box--reveal" : "")">
    @if (Result?.IsFailure == true)
    {
        <ArenaFailureCard DisplayName="@DisplayName"
                          FailureReason="@Result.FailureReason"
                          />
    }
    else
    {
        @* First token: a band of light crosses the panel's top edge once. Transform and
           opacity only — this plays while a browser model may be generating. *@
        @if (Spark)
        {
            <span class="arena-panel__spark" aria-hidden="true"></span>
        }

        @* A win over a model rated higher going in. Text, not decoration: it is a fact about
           the result, so it stays in the accessibility tree. *@
        @if (UpsetGap is { } gap && IsVerdictRecorded && WinnerModelId == PanelModelId)
        {
            <span class="arena-panel__upset @(Reveal ? "arena-panel__upset--reveal" : "")"
                  title="@($"Beat a model rated {gap:N0} points higher")">Upset · +@gap.ToString("N0")</span>
        }

        <SandboxedViewport
            HtmlContent="@(StreamingHtml ?? Result?.HtmlOutputRaw ?? string.Empty)"
            ModelName="@DisplayName"
            IsLoser="@(LoserModelId == PanelModelId)"
            ShowWinner="@(IsVerdictRecorded && WinnerModelId == PanelModelId)"
            IsAwaitingResult="@(StreamingHtml is null && Result is null)"
            IsStreaming="@(Result is null)"
            Reveal="@Reveal"
            EloShift="@EloShift"
            EloRolled="@EloRolled"
            />

        @* Off unless Settings → Arena telemetry is on. *@
        @if (Prefs.IsOn(Preference.ArenaDetails))
        {
            <div class="arena-panel__hud">
                <TelemetryHud Result="Result" Live="Live" Progress="Progress" />
            </div>
        }

        @if (!string.IsNullOrEmpty(Result?.HtmlOutputRaw))
        {
            @* Native disclosure instead of window.open: popup blockers could discard the old
               async JS-interoped tab with no feedback. This stays in the duel and works without
               a popup permission or a second browsing context. *@
            <details class="arena-panel__source">
                <summary aria-label="@($"View source of {DisplayName}")">
                    <span aria-hidden="true">&lt;/&gt;</span> View Source
                </summary>
                <pre><code>@Result.HtmlOutputRaw</code></pre>
            </details>
        }
    }
</div>

@code {
    /// <summary>The result row for this side, or <c>null</c> if the run has not produced one.</summary>
    [Parameter, EditorRequired] public DuelResultDto? Result { get; set; }

    /// <summary>What this side is called in the UI — resolved by the page.</summary>
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    /// <summary>The streaming HTML previewed while inference is running. Null once the run completes.</summary>
    [Parameter] public string? StreamingHtml { get; set; }

    /// <summary>Id of the loser side, used to dim this viewport when it has lost.</summary>
    [Parameter] public ModelId? LoserModelId { get; set; }

    /// <summary>Id of the winner side, used to mark this viewport when it has won.</summary>
    [Parameter] public ModelId? WinnerModelId { get; set; }

    /// <summary>True once a verdict has been recorded — drives the winner / loser treatments.</summary>
    [Parameter] public bool IsVerdictRecorded { get; set; }

    /// <summary>The verdict landed while the page was watching — play the one-shot reveal.
    /// False for a duel opened already decided.</summary>
    [Parameter] public bool Reveal { get; set; }

    /// <summary>The id of the model that occupies this side — supplied by the page so the panel
    /// can compare it to the loser / winner ids without holding its own copy.</summary>
    [Parameter, EditorRequired] public ModelId PanelModelId { get; set; }

    /// <summary>This side's ELO shift, once the server has said what it was.</summary>
    [Parameter] public double? EloShift { get; set; }

    /// <summary>The badge's odometer shows the real digits (else zeros, the frame it rolls from).</summary>
    [Parameter] public bool EloRolled { get; set; }

    /// <summary>How far the loser was rated above the winner going in; stamped on the winner only.</summary>
    [Parameter] public double? UpsetGap { get; set; }

    /// <summary>This side's first token has arrived: play the light streak.</summary>
    [Parameter] public bool Spark { get; set; }

    /// <summary>This side's streaming telemetry while the duel runs; null once it has finished.</summary>
    [Parameter] public SideMetrics? Live { get; set; }

    /// <summary>Race-track position, 0–100, for the live HUD.</summary>
    [Parameter] public double Progress { get; set; }


}
