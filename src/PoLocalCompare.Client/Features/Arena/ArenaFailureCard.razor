@* The failure card shown in place of a side's viewport when its inference failed.
   Identical shape for left and right; the side comes in as the `DisplayName`. *@

<div class="arena-failure__card">
    <div class="arena-failure__title"><span aria-hidden="true">❌</span> @DisplayName failed</div>
    <div class="arena-failure__body">@(FailureReasonText.FirstLine(FailureReason) ?? "No reason provided by the model runtime.")</div>
    <details class="arena-failure__details">
        <summary>Show technical details</summary>
        <pre class="arena-failure__raw">@FailureReason</pre>
    </details>
</div>

@code {
    [Parameter, EditorRequired] public string DisplayName { get; set; } = string.Empty;

    /// <summary>The full failure-reason text. The card body only shows the first line.</summary>
    [Parameter, EditorRequired] public string? FailureReason { get; set; }
}
