@using PoLocalCompare.Shared.Enums
@using PoLocalCompare.Shared.Presentation

@* ── The Arena's status band ───────────────────────────────────────────────────
   One region saying one thing. This was two @if chains and a loose notice in Arena.razor,
   branching across nine separate flags, and each arm carried its own role="status" — ten live
   regions on that page, several of which could update in the same frame. A polite live region
   that fires ten times is a worse experience than one that fires once: a screen reader queues
   them and reads the lot, so the countdown, the cost summary and the verdict all arrive in a
   row with no indication which one the user was waiting for.

   So: one element, one role="status", and its content chosen by ArenaPhase. The wording of
   every arm is carried over verbatim — each sentence was argued for and some of them are the
   fix for a specific misreading (a walkover is not a judgement about quality; a tie moved no
   rating; "Nobody picked in time" explains why the AI is deciding). Changing the structure
   is not a licence to reword them.

   SC 4.1.3 Status Messages: announced without moving focus. That matters most in
   JudgeCountdown, where the thing a user is racing the clock to reach is the vote buttons
   BELOW this band — stealing focus here would take it away from them. *@

@if (Phase is not ArenaPhase.Idle)
{
    <div class="@BandClass" role="status">
        @switch (Phase)
        {
            case ArenaPhase.Running:
                @* The race ticker (who is ahead, who finished). It was TokenRace's own
                   role="status" in a panel above this one — two live regions narrating the
                   same race. The visible ticker re-words itself on every streamed batch, so it
                   is aria-hidden and the region speaks RaceAnnouncement instead, which changes
                   only on warm-up, a lead change or a finish. *@
                <span aria-hidden="true">⚡ @(RaceTicker ?? InProgress)</span>
                <span class="visually-hidden">@(RaceAnnouncement ?? InProgress)</span>
                break;

            case ArenaPhase.WaitingForOtherModel:
                <span>
                    <span aria-hidden="true">⏳</span>
                    First result is in — waiting for the other model to finish.
                </span>
                break;

            case ArenaPhase.BothSidesFailed:
                <span>Both models failed — start a new duel with a different pairing.</span>
                break;

            case ArenaPhase.JudgeDeciding:
                <span><span aria-hidden="true">⚖</span> Nobody picked in time — the AI judge is deciding…</span>
                break;

            case ArenaPhase.JudgeCountdown:
                @* The visible clock ticks every second; the spoken one says it once at the start
                   and once more at FinalCall, rather than re-reading the sentence each tick. *@
                <span aria-hidden="true">
                    ⚖
                    Quick override: pick a winner within
                    <strong>@AutoJudgeRemaining</strong> @Seconds(AutoJudgeRemaining).
                </span>
                <span class="visually-hidden">The AI judge is primary. Pick a winner within @_spokenRemaining @Seconds(_spokenRemaining) to override it.</span>
                break;

            case ArenaPhase.AwaitingHumanPick:
                <span><span aria-hidden="true">⚖</span> Pick the winner below.</span>
                break;

            case ArenaPhase.VerdictOptimistic:
                <span>Winner: <strong>@WinnerDisplayName</strong> — recording…</span>
                break;

            case ArenaPhase.VerdictVoided:
                @* Terminal with nothing to judge: no winner to name, no rating that moved.
                   Before this branch existed a voided duel rendered with no status line at
                   all and no vote buttons — a page with nothing to say about why. *@
                <span>
                    <span aria-hidden="true">⊘</span>
                    Duel voided — there was no result to judge, so no rating moved.
                </span>
                break;

            case ArenaPhase.VerdictTie:
                @* A tie has no winner to name, so it says what happened instead — and says
                   explicitly that ratings did not move, because "no winner" otherwise reads
                   as "the judge never ran". *@
                <span>
                    <span aria-hidden="true">🤝</span>
                    Judged a tie — both outputs were found equivalent, so no rating moved.
                </span>
                break;

            case ArenaPhase.VerdictWalkover:
                @* No model read the outputs here — one side simply did not produce any. Said
                   plainly, so a walkover is never mistaken for a judgement about quality.
                   This used to read "Won on the challenge budget"; challenge mode was removed
                   on 2026-09-10, but AutoJudge and DuelRecoverySweeper still stamp Constraint
                   for one-sided failures and abandoned duels. *@
                <span>Won by walkover — Winner: <strong>@WinnerDisplayName</strong></span>
                break;

            case ArenaPhase.VerdictByAi:
                <span>Decided by the AI judge — Winner: <strong>@WinnerDisplayName</strong></span>
                break;

            default:
                <span>Verdict recorded ✓ — Winner: <strong>@WinnerDisplayName</strong></span>
                break;
        }

        @* The judge's own words, where there are any. Quoted for the two phases where a model
           was actually reading the outputs and is being paraphrased; unquoted for a walkover
           and a void, where the sentence is a statement of fact about the duel rather than a
           judgement someone made. *@
        @if (RationaleText is { } rationale)
        {
            <span class="arena-band__rationale">@rationale</span>
        }

        @* The judge's own element-by-element checklist, written before it picked a winner.
           It is the evidence behind the one-line reason above and was already being paid for
           — the server parsed it and threw it away until 2026-10-11. Closed by default: the
           verdict is the news, this is for whoever wants to check it. Only where a model
           actually read the outputs; a walkover has no analysis to show. *@
        @if (QuotesRationale && !string.IsNullOrWhiteSpace(JudgeAnalysis))
        {
            <details class="arena-band__analysis">
                <summary>How the judge scored it</summary>
                <p class="arena-band__analysis-text">@JudgeAnalysis</p>
            </details>
        }

        @* Forensic attribution — visible to the user, but never used for authorization.
           For Human verdicts this is the clicker; for AI verdicts this is null and we
           fall back to the deployment name. *@
        @if (Phase is ArenaPhase.VerdictByHuman && !string.IsNullOrWhiteSpace(VerdictBy))
        {
            <span class="arena-band__by">Judged by <strong>@VerdictBy</strong></span>
        }
        else if (Phase is ArenaPhase.VerdictByAi or ArenaPhase.VerdictWalkover
                 && !string.IsNullOrWhiteSpace(JudgeModel))
        {
            <span class="arena-band__by">Judge: <strong>@JudgeModel</strong></span>
        }

        @* A pick that lost the race to the auto-judge, corrected visibly rather than swapped
           silently underneath the person who made it. Inside the band so the correction and
           the verdict it corrects are one announcement, not two competing live regions. *@
        @if (Notice is not null)
        {
            <span class="arena-band__notice">@Notice</span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ArenaPhase Phase { get; set; }

    /// <summary>Seconds left in the grace window — read only in <see cref="ArenaPhase.JudgeCountdown"/>.</summary>
    [Parameter] public int? AutoJudgeRemaining { get; set; }

    /// <summary>The winner's resolved display name, for the four phases that name one.</summary>
    [Parameter] public string? WinnerDisplayName { get; set; }

    /// <summary>The judge's one-line reason, when it gave one.</summary>
    [Parameter] public string? JudgeRationale { get; set; }

    /// <summary>The judge's checklist behind its reason, when it gave one.</summary>
    [Parameter] public string? JudgeAnalysis { get; set; }

    /// <summary>The human who clicked, for a Human verdict.</summary>
    [Parameter] public string? VerdictBy { get; set; }

    /// <summary>The judge deployment name, for an AI or Constraint verdict.</summary>
    [Parameter] public string? JudgeModel { get; set; }

    /// <summary>The live race summary for <see cref="ArenaPhase.Running"/> ("X is 1.4× faster right now"). Visual only.</summary>
    [Parameter] public string? RaceTicker { get; set; }

    /// <summary>What the live region says during <see cref="ArenaPhase.Running"/> — changes only when the race's story does.</summary>
    [Parameter] public string? RaceAnnouncement { get; set; }

    private const string InProgress = "Duel in progress — previewing output as it streams…";

    /// <summary>The countdown is re-announced once more when it reaches this many seconds.</summary>
    private const int FinalCall = 3;

    /// <summary>The countdown value the live region last said; null outside the countdown.</summary>
    private int? _spokenRemaining;

    private static string Seconds(int? n) => n == 1 ? "second" : "seconds";

    /// <summary>A correction of the verdict shown (the user's pick lost the race to the judge).</summary>
    [Parameter] public string? Notice { get; set; }

    private bool ShowsRationale =>
        Phase is ArenaPhase.VerdictVoided
              or ArenaPhase.VerdictTie
              or ArenaPhase.VerdictWalkover
              or ArenaPhase.VerdictByAi;

    private bool QuotesRationale =>
        Phase is ArenaPhase.VerdictTie or ArenaPhase.VerdictByAi;

    private string? RationaleText =>
        string.IsNullOrWhiteSpace(JudgeRationale) || !ShowsRationale ? null
        : QuotesRationale ? $"“{JudgeRationale}”" : JudgeRationale;

    protected override void OnParametersSet()
    {
        if (Phase is ArenaPhase.JudgeCountdown && AutoJudgeRemaining is { } left)
        {
            if (_spokenRemaining is not { } spoken || (left <= FinalCall && spoken > FinalCall))
                _spokenRemaining = left;
        }
        else
        {
            _spokenRemaining = null;
        }
    }

    /// <summary>
    /// The band's own class. Three visual treatments, matching what the separate blocks used
    /// to carry: the settled verdict panel, the judge's note, and the live streaming notice.
    /// </summary>
    private string BandClass => Phase switch
    {
        ArenaPhase.Running => "arena-band__box arena-band__box--live",
        ArenaPhase.BothSidesFailed => "arena-band__box arena-band__box--error",
        ArenaPhase.JudgeDeciding or ArenaPhase.JudgeCountdown => "arena-band__box arena-band__box--judging",
        ArenaPhase.WaitingForOtherModel or ArenaPhase.AwaitingHumanPick => "arena-band__box arena-band__box--note",
        ArenaPhase.VerdictOptimistic => "arena-band__box arena-band__box--verdict arena-band__box--pending",
        _ => "arena-band__box arena-band__box--verdict",
    };
}
