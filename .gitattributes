# Normalise line endings: LF in the repo, LF in the working tree on every OS.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# web-llm.js (~6 MB bundle) is a Git LFS object; scripts/ci-checks.ps1 pulls it.
src/PoLocalCompare.Client/wwwroot/js/web-llm.js filter=lfs diff=lfs merge=lfs -text
